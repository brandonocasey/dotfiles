#!/usr/bin/env node
'use strict';

const fs = require('node:fs');
const http = require('node:http');
const crypto = require('node:crypto');
const path = require('node:path');
const os = require('node:os');
const { spawn } = require('node:child_process');

function fail(message) {
  process.stderr.write(`agent-preview: ${message}\n`);
  process.exitCode = 1;
}

function usage() {
  return `Usage:
  agent-preview serve --config PATH --state-dir PATH --port N [--detach true]
  agent-preview stop --state-dir PATH
  agent-preview wait --state-dir PATH --after N --timeout-seconds N
`;
}

function argumentsFor(command, argv) {
  const values = {};
  for (let index = 0; index < argv.length; index += 2) {
    const key = argv[index];
    const value = argv[index + 1];
    if (!key?.startsWith('--') || value === undefined) {
      throw new Error(`invalid ${command} arguments\n${usage()}`);
    }
    values[key.slice(2)] = value;
  }
  return values;
}

function privateDirectory(directory) {
  const absolute = path.resolve(directory);
  if (!fs.existsSync(absolute)) fs.mkdirSync(absolute, { recursive: true, mode: 0o700 });
  const metadata = fs.lstatSync(absolute);
  if (metadata.isSymbolicLink() || !metadata.isDirectory()) {
    throw new Error('state-dir must be a real directory');
  }
  const resolved = fs.realpathSync(absolute);
  fs.chmodSync(resolved, 0o700);
  return resolved;
}

function readJson(filename) {
  if (fs.lstatSync(filename).isSymbolicLink()) throw new Error(`refusing symbolic link: ${filename}`);
  const descriptor = fs.openSync(filename, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0));
  try {
    return JSON.parse(fs.readFileSync(descriptor, 'utf8'));
  } finally {
    fs.closeSync(descriptor);
  }
}

function writePrivateJson(filename, value) {
  if (fs.existsSync(filename) && fs.lstatSync(filename).isSymbolicLink()) {
    throw new Error(`refusing symbolic link: ${filename}`);
  }
  const temporary = `${filename}.${process.pid}.new`;
  try {
    fs.writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600, flag: 'wx' });
    fs.renameSync(temporary, filename);
    fs.chmodSync(filename, 0o600);
  } finally {
    try { fs.unlinkSync(temporary); } catch (error) { if (error.code !== 'ENOENT') throw error; }
  }
}

function watchChanges(filename, listener) {
  let nativeWatcher;
  let polling = false;
  let closed = false;
  const fallback = error => {
    nativeWatcher?.close();
    if (closed || polling) return;
    polling = true;
    process.stderr.write(`agent-preview: native watcher unavailable (${error.code || error.message}); using file-stat checks\n`);
    fs.watchFile(filename, { interval: 250 }, listener);
  };
  try {
    nativeWatcher = fs.watch(path.dirname(filename), (_event, changed) => {
      if (changed === null || changed.toString() === path.basename(filename)) listener();
    });
    nativeWatcher.on('error', fallback);
  } catch (error) {
    fallback(error);
  }
  return { close() {
    closed = true;
    nativeWatcher?.close();
    if (polling) fs.unwatchFile(filename, listener);
  } };
}

function validateOption(option, where, filename, ids) {
  if (!option || typeof option !== 'object' || Array.isArray(option)) {
    throw new Error(`${where} must be an object`);
  }
  if (typeof option.id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(option.id)) {
    throw new Error(`${where}.id is invalid`);
  }
  if (ids.has(option.id)) throw new Error(`duplicate option id: ${option.id}`);
  ids.add(option.id);
  if (typeof option.label !== 'string' || option.label.length < 1 || option.label.length > 120) {
    throw new Error(`${where}.label must contain 1 to 120 characters`);
  }
  if (option.kind !== 'image' && option.kind !== 'html') {
    throw new Error(`${where}.kind must be image or html`);
  }
  const scripts = option.scripts ?? false;
  if (typeof scripts !== 'boolean' || (scripts && option.kind !== 'html')) {
    throw new Error(`${where}.scripts must be a boolean for HTML options`);
  }
  if (typeof option.path !== 'string' || option.path.length < 1) {
    throw new Error(`${where}.path is required`);
  }
  const requested = path.resolve(path.dirname(filename), option.path);
  const real = fs.realpathSync(requested);
  const metadata = fs.statSync(real);
  if (!metadata.isFile()) throw new Error(`option is not a regular file: ${option.id}`);
  const description = option.description ?? '';
  if (typeof description !== 'string' || description.length > 500) {
    throw new Error(`${where}.description must be at most 500 characters`);
  }
  return { id: option.id, label: option.label, kind: option.kind, scripts, description, requested, real, dev: metadata.dev, ino: metadata.ino };
}

function validateConfig(filename) {
  const config = readJson(filename);
  if (!config || typeof config !== 'object' || Array.isArray(config)) {
    throw new Error('config must be a JSON object');
  }
  if (typeof config.title !== 'string' || config.title.length < 1 || config.title.length > 120) {
    throw new Error('config.title must contain 1 to 120 characters');
  }
  const hasQuestions = config.questions !== undefined;
  if (hasQuestions === (config.options !== undefined)) {
    throw new Error('config must have exactly one of questions or options');
  }
  const rawQuestions = hasQuestions
    ? config.questions
    : [{ id: 'choices', title: config.title, select: 'many', options: config.options }];
  if (!Array.isArray(rawQuestions) || rawQuestions.length < 1 || rawQuestions.length > 20) {
    throw new Error('config.questions must contain 1 to 20 questions');
  }
  const ids = new Set();
  const questionIds = new Set();
  let total = 0;
  const questions = rawQuestions.map((question, index) => {
    const where = hasQuestions ? `config.questions[${index}]` : 'config';
    if (!question || typeof question !== 'object' || Array.isArray(question)) {
      throw new Error(`${where} must be an object`);
    }
    if (typeof question.id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(question.id)) {
      throw new Error(`${where}.id is invalid`);
    }
    if (questionIds.has(question.id)) throw new Error(`duplicate question id: ${question.id}`);
    questionIds.add(question.id);
    if (typeof question.title !== 'string' || question.title.length < 1 || question.title.length > 120) {
      throw new Error(`${where}.title must contain 1 to 120 characters`);
    }
    const prompt = question.prompt ?? '';
    if (typeof prompt !== 'string' || prompt.length > 500) {
      throw new Error(`${where}.prompt must be at most 500 characters`);
    }
    const select = question.select ?? 'one';
    if (select !== 'one' && select !== 'many') throw new Error(`${where}.select must be one or many`);
    if (!Array.isArray(question.options) || question.options.length < 1) {
      throw new Error(`${where}.options must contain at least 1 option`);
    }
    total += question.options.length;
    if (total > 100) throw new Error('config must contain at most 100 options in total');
    const options = question.options.map((option, optionIndex) =>
      validateOption(option, `${where}.options[${optionIndex}]`, filename, ids));
    return { id: question.id, title: question.title, prompt, select, options };
  });
  return { title: config.title, questions, options: questions.flatMap(question => question.options), ids };
}

function contentType(option) {
  if (option.kind === 'html') return 'text/html; charset=utf-8';
  const extension = path.extname(option.requested).toLowerCase();
  return new Map([
    ['.avif', 'image/avif'], ['.gif', 'image/gif'], ['.jpg', 'image/jpeg'],
    ['.jpeg', 'image/jpeg'], ['.png', 'image/png'], ['.svg', 'image/svg+xml'],
    ['.webp', 'image/webp'],
  ]).get(extension) || 'application/octet-stream';
}

function publicConfig(config, revision) {
  return {
    title: config.title,
    questions: config.questions.map(({ id, title, prompt, select, options }) => ({
      id, title, prompt, select,
      options: options.map(({ id: optionId, label, kind, description }) => ({ id: optionId, label, kind, description })),
    })),
    revision,
  };
}

function previewAsset(name) {
  const directory = path.basename(__filename) === 'executable_agent-preview'
    ? path.resolve(__dirname, '../../dot_config/agents/skills/preview/assets')
    : path.join(process.env.XDG_CONFIG_HOME || path.join(os.homedir(), '.config'), 'agents/skills/preview/assets');
  return fs.readFileSync(path.join(directory, name), 'utf8');
}

function page(config, token, revision, ui) {
  const data = JSON.stringify({ ...publicConfig(config, revision), token }).replace(/</g, '\\u003c');
  return ui.html.replace('{{PREVIEW_DATA}}', () => data)
    .replace('{{PREVIEW_SCRIPT}}', () => ui.script);
}

function requestHasValidOrigin(request) {
  if (request.headers.host === undefined) return false;
  const origin = request.headers.origin;
  if (origin && origin !== `http://${request.headers.host}`) return false;
  return true;
}

function sendJson(response, status, value) {
  response.writeHead(status, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' });
  response.end(`${JSON.stringify(value)}\n`);
}

function processIsRunning(pid) {
  if (!Number.isSafeInteger(pid) || pid < 1) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error.code === 'EPERM';
  }
}

function reserveServerFile(filename, metadata) {
  if (fs.existsSync(filename)) {
    const current = readJson(filename);
    if (processIsRunning(current.pid)) throw new Error(`state directory is in use by process ${current.pid}`);
    fs.unlinkSync(filename);
  }
  fs.writeFileSync(filename, `${JSON.stringify(metadata, null, 2)}\n`, { mode: 0o600, flag: 'wx' });
}

function serveAsset(option, response, annotationScript) {
  const flags = fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0);
  fs.open(option.requested, flags, (openError, descriptor) => {
    if (openError) return sendJson(response, 404, { error: 'option asset is unavailable' });
    fs.fstat(descriptor, (statError, metadata) => {
      if (statError || !metadata.isFile() || metadata.dev !== option.dev || metadata.ino !== option.ino) {
        fs.close(descriptor, () => {});
        return sendJson(response, 404, { error: 'option asset changed after startup' });
      }
      const nonce = crypto.randomBytes(18).toString('base64');
      const scripts = option.scripts ? "'unsafe-inline'" : `'nonce-${nonce}'`;
      const headers = {
        'content-type': contentType(option), 'cache-control': 'no-store',
        'referrer-policy': 'no-referrer', 'x-content-type-options': 'nosniff',
        'content-security-policy': `sandbox allow-scripts; default-src 'none'; script-src ${scripts}; img-src data:; style-src 'unsafe-inline'; font-src data:; base-uri 'none'; form-action 'none'`,
      };
      if (option.kind === 'html') {
        return fs.readFile(descriptor, 'utf8', (error, html) => {
          fs.close(descriptor, () => {});
          if (error) return sendJson(response, 404, { error: 'option asset is unavailable' });
          response.writeHead(200, headers);
          const bridge = `<script nonce="${nonce}">${annotationScript}</script>`;
          const doctype = /^(\s*(?:<!--[\s\S]*?-->\s*)*<!doctype[^>]*>)/i;
          const instrumented = doctype.test(html) ? html.replace(doctype, match => match + bridge) : bridge + html;
          response.end(instrumented);
        });
      }
      response.writeHead(200, headers);
      const stream = fs.createReadStream(option.requested, { fd: descriptor, autoClose: true });
      stream.on('error', () => response.destroy());
      stream.pipe(response);
    });
  });
}

// The token survives restarts, so a restarted server keeps the URL the user has open.
function persistentToken(filename) {
  if (fs.existsSync(filename)) {
    if (fs.lstatSync(filename).isSymbolicLink()) throw new Error(`refusing symbolic link: ${filename}`);
    const stored = fs.readFileSync(filename, 'utf8').trim();
    if (/^[A-Za-z0-9_-]{32}$/.test(stored)) return stored;
  }
  const token = crypto.randomBytes(24).toString('base64url');
  fs.writeFileSync(filename, `${token}\n`, { mode: 0o600 });
  return token;
}

function lanAddress() {
  for (const entries of Object.values(os.networkInterfaces())) {
    for (const entry of entries || []) if (entry.family === 'IPv4' && !entry.internal) return entry.address;
  }
  return '127.0.0.1';
}

function validText(value, label, limit = 4000) {
  if (typeof value !== 'string' || value.length > limit) throw new Error(`invalid ${label}`);
  return value;
}

function validateReviews(input, config) {
  if (!input || typeof input !== 'object' || Array.isArray(input)) throw new Error('invalid reviews');
  const reviews = Object.fromEntries(Object.entries(input).map(([id, review]) => {
    if (!config.ids.has(id)) throw new Error(`unknown reviewed option: ${id}`);
    if (!review || !['approved', 'rejected', 'unreviewed'].includes(review.status)) throw new Error(`invalid review status: ${id}`);
    const comment = validText(review.comment, 'option comment');
    if (!Array.isArray(review.annotations) || review.annotations.length > 30) throw new Error(`invalid annotations: ${id}`);
    const option = config.options.find(candidate => candidate.id === id);
    const annotations = review.annotations.map(annotation => {
      if (!annotation || !annotation.anchor) throw new Error('invalid annotation');
      const anchor = annotation.anchor;
      let normalized;
      if (anchor.kind === 'element' && option.kind === 'html') {
        const selector = validText(anchor.selector, 'element selector', 1000);
        if (!selector.length) throw new Error('empty element selector');
        normalized = { kind: 'element', selector, text: validText(anchor.text, 'element text', 500) };
        if (anchor.matchIndex !== undefined) {
          if (!Number.isSafeInteger(anchor.matchIndex) || anchor.matchIndex < 0) throw new Error('invalid element match index');
          normalized.matchIndex = anchor.matchIndex;
        }
      } else if (anchor.kind === 'point' && option.kind === 'image') {
        if (![anchor.x, anchor.y].every(value => typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= 1)) {
          throw new Error('invalid image point');
        }
        normalized = { kind: 'point', x: anchor.x, y: anchor.y };
      } else throw new Error('annotation does not match the option kind');
      return { anchor: normalized, comment: validText(annotation.comment, 'annotation comment') };
    });
    return [id, { status: review.status, comment, annotations }];
  }));
  for (const question of config.questions) {
    if (question.select === 'one' && question.options.filter(option => reviews[option.id]?.status === 'approved').length > 1) {
      throw new Error(`question takes one approval: ${question.id}`);
    }
  }
  return reviews;
}

function validateCombinations(input, config) {
  if (!Array.isArray(input) || input.length > 50) throw new Error('invalid combinations');
  return input.map(combination => {
    if (!combination || !Array.isArray(combination.ids) || combination.ids.length < 2 || combination.ids.length > 100 ||
        new Set(combination.ids).size !== combination.ids.length || combination.ids.some(id => !config.ids.has(id))) {
      throw new Error('a combination needs at least two different current options');
    }
    return { ids: combination.ids, notes: validText(combination.notes, 'combination notes') };
  });
}

function serve(values) {
  if (!values.config || !values['state-dir'] || !values.port) throw new Error(`missing serve option\n${usage()}`);
  const port = Number(values.port);
  if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error('port must be from 1 through 65535');
  const configFile = fs.realpathSync(values.config);
  let config = validateConfig(configFile);
  const ui = { html: previewAsset('gallery.html'), script: previewAsset('gallery.js') };
  const annotationScript = previewAsset('annotation.js');
  let revision = Date.now();
  const stateDir = privateDirectory(values['state-dir']);
  const stateFile = path.join(stateDir, 'state.json');
  const serverFile = path.join(stateDir, 'server.json');
  const token = persistentToken(path.join(stateDir, 'token'));
  if (!fs.existsSync(stateFile)) writePrivateJson(stateFile, { seq: 0, selected: [], rejected: [], events: [] });
  reserveServerFile(serverFile, { token, port, config: configFile, pid: process.pid });
  const eventClients = new Set();
  const server = http.createServer((request, response) => {
    let url;
    try {
      url = new URL(request.url, `http://${request.headers.host || 'invalid'}`);
    } catch {
      return sendJson(response, 400, { error: 'invalid request URL' });
    }
    const suppliedToken = request.headers['x-preview-token'] || url.searchParams.get('token');
    if (!requestHasValidOrigin(request) || suppliedToken !== token) return sendJson(response, 403, { error: 'forbidden' });
    if (request.method === 'GET' && url.pathname === '/') {
      response.writeHead(200, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store', 'referrer-policy': 'no-referrer', 'content-security-policy': "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; frame-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" });
      return response.end(page(config, token, revision, ui));
    }
    if (request.method === 'GET' && url.pathname === '/config') {
      return sendJson(response, 200, publicConfig(config, revision));
    }
    if (request.method === 'GET' && url.pathname === '/events') {
      response.writeHead(200, {
        'content-type': 'text/event-stream; charset=utf-8',
        'cache-control': 'no-store',
        connection: 'keep-alive',
      });
      response.write(`data: ${revision}\n\n`);
      eventClients.add(response);
      request.on('close', () => eventClients.delete(response));
      return;
    }
    if (request.method === 'GET' && url.pathname.startsWith('/asset/')) {
      let id;
      try {
        id = decodeURIComponent(url.pathname.slice('/asset/'.length));
      } catch {
        return sendJson(response, 400, { error: 'invalid option id encoding' });
      }
      const option = config.options.find(candidate => candidate.id === id);
      if (!option) return sendJson(response, 404, { error: 'unknown option' });
      return serveAsset(option, response, annotationScript);
    }
    if (request.method === 'POST' && url.pathname === '/submit') {
      let body = '';
      let bytes = 0;
      request.setEncoding('utf8');
      request.on('data', chunk => {
        bytes += Buffer.byteLength(chunk);
        if (bytes <= 1048576) body += chunk;
      });
      return request.on('end', () => {
        if (bytes > 1048576) return sendJson(response, 413, { error: 'feedback exceeds 1 MiB; shorten comments or remove pins' });
        try {
          const input = JSON.parse(body);
          if (!input || typeof input !== 'object') throw new Error('invalid submission');
          if (!['select', 'reject', 'more', 'review'].includes(input.action)) throw new Error('invalid action');
          if (input.submissionId !== undefined && (typeof input.submissionId !== 'string' || !/^[A-Za-z0-9_-]{1,80}$/.test(input.submissionId))) throw new Error('invalid submission ID');
          const state = readJson(stateFile);
          const prior = input.submissionId && state.events.find(event => event.submissionId === input.submissionId);
          if (prior) return sendJson(response, 200, { seq: prior.seq });
          if (input.revision !== undefined && input.revision !== revision) return sendJson(response, 409, { error: 'options changed; load the new options before submitting' });
          if (!Array.isArray(input.ids) || input.ids.some(id => typeof id !== 'string' || !config.ids.has(id))) throw new Error('invalid option ids');
          if ((input.action === 'select' || input.action === 'reject') && input.ids.length < 1) throw new Error('select at least one option');
          if (typeof input.notes !== 'string' || input.notes.length > 4000) throw new Error('invalid notes');
          const answers = input.answers ?? {};
          if (!answers || typeof answers !== 'object' || Array.isArray(answers)) throw new Error('invalid answers');
          for (const [questionId, answer] of Object.entries(answers)) {
            const question = config.questions.find(candidate => candidate.id === questionId);
            if (!question) throw new Error(`unknown question: ${questionId}`);
            if (!answer || !Array.isArray(answer.ids) || typeof answer.notes !== 'string' || answer.notes.length > 4000) throw new Error(`invalid answer: ${questionId}`);
            if (answer.ids.some(id => !question.options.some(option => option.id === id))) throw new Error(`answer has an option from another question: ${questionId}`);
            if (question.select === 'one' && answer.ids.length > 1) throw new Error(`question takes one answer: ${questionId}`);
          }
          const hasReviews = input.reviews !== undefined;
          if (input.action === 'review' && !hasReviews) throw new Error('review requires option reviews');
          const reviews = hasReviews ? validateReviews(input.reviews, config) : undefined;
          const requirements = validText(input.requirements ?? '', 'requirements');
          const combinations = validateCombinations(input.combinations ?? [], config);
          if (hasReviews) {
            const approved = Object.keys(reviews).filter(id => reviews[id].status === 'approved');
            if (approved.length !== new Set(input.ids).size || approved.some(id => !input.ids.includes(id))) throw new Error('approved options do not match submission IDs');
            for (const question of config.questions) {
              const answerIds = answers[question.id]?.ids || [];
              const expected = question.options.filter(option => reviews[option.id]?.status === 'approved').map(option => option.id);
              if (expected.length !== answerIds.length || expected.some(id => !answerIds.includes(id))) throw new Error(`approvals do not match the answer: ${question.id}`);
            }
          }
          state.seq += 1;
          const event = { seq: state.seq, action: input.action, ids: [...new Set(input.ids)], notes: input.notes, answers, at: new Date().toISOString() };
          if (input.submissionId) event.submissionId = input.submissionId;
          if (hasReviews) Object.assign(event, { reviews, requirements, combinations, revision });
          state.events.push(event);
          if (input.action === 'select') {
            state.selected = [...new Set([...state.selected, ...event.ids])];
            state.rejected = state.rejected.filter(id => !event.ids.includes(id));
          }
          if (input.action === 'reject') {
            state.rejected = [...new Set([...state.rejected, ...event.ids])];
            state.selected = state.selected.filter(id => !event.ids.includes(id));
          }
          if (hasReviews) {
            const reviewed = new Set(Object.keys(reviews));
            state.selected = state.selected.filter(id => !reviewed.has(id));
            state.rejected = state.rejected.filter(id => !reviewed.has(id));
            for (const [id, review] of Object.entries(reviews)) {
              if (review.status === 'approved') state.selected.push(id);
              if (review.status === 'rejected') state.rejected.push(id);
            }
          }
          writePrivateJson(stateFile, state);
          return sendJson(response, 200, { seq: state.seq });
        } catch (error) { return sendJson(response, 400, { error: error.message }); }
      });
    }
    return sendJson(response, 404, { error: 'not found' });
  });
  let refreshTimer;
  const configWatcher = watchChanges(configFile, () => {
    clearTimeout(refreshTimer);
    refreshTimer = setTimeout(() => {
      try {
        config = validateConfig(configFile);
        revision += 1;
        for (const client of eventClients) client.write(`data: ${revision}\n\n`);
      } catch (error) {
        process.stderr.write(`agent-preview: ignored invalid config update: ${error.message}\n`);
      }
    }, 50);
  });
  const release = () => {
    try {
      const current = readJson(serverFile);
      if (current.pid === process.pid) fs.unlinkSync(serverFile);
    } catch (error) {
      if (error.code !== 'ENOENT') fail(`could not release server state: ${error.message}`);
    }
  };
  server.on('error', error => {
    configWatcher.close();
    clearTimeout(refreshTimer);
    release();
    fail(`could not listen on 0.0.0.0:${port}: ${error.message}`);
  });
  server.on('close', () => {
    configWatcher.close();
    clearTimeout(refreshTimer);
    release();
  });
  for (const signal of ['SIGINT', 'SIGTERM']) process.once(signal, () => {
    configWatcher.close();
    clearTimeout(refreshTimer);
    for (const client of eventClients) client.end();
    server.close();
  });
  server.listen(port, '0.0.0.0', () => process.stdout.write(`${JSON.stringify({ port, token, pid: process.pid, url: `http://${lanAddress()}:${port}/?token=${token}` })}\n`));
}

// A detached server outlives the agent's tool call, so harness time limits
// on background commands cannot stop it while the user is still choosing.
function serveDetached(values) {
  const stateDir = privateDirectory(values['state-dir']);
  const log = path.join(stateDir, 'server.log');
  const output = fs.openSync(log, 'w', 0o600);
  const args = [__filename, 'serve', '--config', values.config, '--state-dir', stateDir, '--port', values.port];
  const child = spawn(process.execPath, args, { detached: true, stdio: ['ignore', output, output] });
  child.unref();
  const deadline = Date.now() + 10000;
  const poll = () => {
    const text = fs.readFileSync(log, 'utf8');
    const line = text.split('\n').find(entry => entry.startsWith('{'));
    if (line) return process.stdout.write(`${line}\n`);
    if (child.exitCode !== null || text.includes('agent-preview:') || Date.now() > deadline) {
      return fail(`detached server did not start: ${text.trim() || 'no output'}`);
    }
    setTimeout(poll, 50);
  };
  poll();
}

function stop(values) {
  if (!values['state-dir']) throw new Error(`missing stop option\n${usage()}`);
  const serverFile = path.join(privateDirectory(values['state-dir']), 'server.json');
  if (!fs.existsSync(serverFile)) return process.stdout.write('not running\n');
  const { pid } = readJson(serverFile);
  if (!processIsRunning(pid)) {
    fs.unlinkSync(serverFile);
    return process.stdout.write('not running\n');
  }
  process.kill(pid, 'SIGTERM');
  process.stdout.write(`stopped ${pid}\n`);
}

function waitForState(values) {
  if (!values['state-dir'] || values.after === undefined || values['timeout-seconds'] === undefined) throw new Error(`missing wait option\n${usage()}`);
  const after = Number(values.after);
  const timeout = Number(values['timeout-seconds']);
  if (!Number.isSafeInteger(after) || after < 0) throw new Error('after must be a nonnegative integer');
  if (!Number.isFinite(timeout) || timeout < 0 || timeout > 86400) throw new Error('timeout-seconds must be from 0 through 86400');
  const stateDir = privateDirectory(values['state-dir']);
  const stateFile = path.join(stateDir, 'state.json');
  const emit = () => {
    if (!fs.existsSync(stateFile)) return false;
    let state;
    try {
      state = readJson(stateFile);
    } catch (error) {
      if (error.code === 'ENOENT') return false;
      throw error;
    }
    const events = state.events.filter(event => event.seq > after);
    if (!events.length) return false;
    process.stdout.write(`${JSON.stringify({ cursor: state.seq, events, selected: state.selected, rejected: state.rejected })}\n`);
    return true;
  };
  if (timeout === 0) {
    emit();
    return;
  }
  let timer;
  const watcher = watchChanges(stateFile, () => {
    if (emit()) {
      watcher.close();
      clearTimeout(timer);
    }
  });
  timer = setTimeout(() => watcher.close(), timeout * 1000);
  if (emit()) {
    watcher.close();
    clearTimeout(timer);
  }
}

try {
  const [command, ...argv] = process.argv.slice(2);
  if (command === '--help' || command === '-h') process.stdout.write(usage());
  else if (command === 'serve') {
    const values = argumentsFor(command, argv);
    if (values.detach === 'true') serveDetached(values);
    else serve(values);
  } else if (command === 'stop') stop(argumentsFor(command, argv));
  else if (command === 'wait') waitForState(argumentsFor(command, argv));
  else throw new Error(usage());
} catch (error) {
  fail(error.message);
}
