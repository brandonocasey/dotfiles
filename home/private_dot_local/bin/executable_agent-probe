#!/usr/bin/env python3
"""Run `claude -p` variants in fresh scratch directories and compare their usage.

Usage: agent-probe (--prompt TEXT | --prompt-file FILE) [--variant NAME=ARGS]... [-n RUNS] [options]

NAME is letters, digits, '.', '_' or '-'; it names the run logs in --out.

  agent-probe --prompt 'Reply with OK only.' \\
      --variant base= --variant off='--settings off.json' -n 3

Each run gets a new empty working directory, `--no-session-persistence`, and
stream-json output kept apart from stderr. Variant arguments that name existing
files are made absolute first. A run whose MCP servers are still
pending or failed at start is retried. USD comes from `agt sessions` and the
shared price file. Working directories are deleted afterwards; logs stay in
--out. Runs use `claude` with the caller's CLAUDE_CONFIG_DIR.

Without tool search, Claude Code sends every MCP tool schema in full: about
600k tokens per call with the claude.ai connectors. So a `--tools` list that
can see MCP servers gains ToolSearch, and a run with tool search off through
the environment or flags (ENABLE_TOOL_SEARCH=false, a custom
ANTHROPIC_BASE_URL, or ToolSearch disallowed) gains --strict-mcp-config. Then
each variant starts once against an invalid model, which prints the tool list
and makes no billed call. If MCP servers are present but ToolSearch is not
(for example, turned off in a --settings file), nothing runs. A run that still
starts that way is marked failed. --allow-inline-tools turns all of this off.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import statistics
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

SCRATCH = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'agents/scratch/agent-probe'
RETRY_STATUSES = {'pending', 'failed'}
TOOL_SEARCH = 'ToolSearch'
TOOLS_FLAGS = ('--tools',)
DISALLOWED_FLAGS = ('--disallowedTools', '--disallowed-tools')
OFF_VALUES = {'0', 'false', 'no', 'off'}
# The API rejects this model unbilled, after Claude Code has printed its init event.
CHECK_MODEL = 'claude-agent-probe-startup-check'
LIVE_MCP_STATUSES = {'connected', 'pending'}
VARIANT_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')


def sessions_tool():
    return shutil.which('agt')


def parse_variant(spec):
    name, sep, flags = spec.partition('=')
    if not sep or not name:
        raise argparse.ArgumentTypeError(f'variant must be NAME=ARGS, got {spec!r}')
    # NAME becomes part of the log file names, so it must stay inside --out.
    if not VARIANT_NAME.fullmatch(name):
        raise argparse.ArgumentTypeError(
            f'variant name must be letters, digits, ".", "_" or "-", starting with a letter or digit; got {name!r}')
    return name, [absolute_if_file(arg) for arg in shlex.split(flags)]


def absolute_if_file(arg):
    """Runs start in an empty directory, so a relative path (`off.json`, `--settings=off.json`) must be made absolute."""
    flag, sep, value = arg.rpartition('=') if arg.startswith('--') else ('', '', arg)
    if value and not os.path.isabs(value) and os.path.exists(value):
        return flag + sep + os.path.abspath(value)
    return arg


def split_flag(flags, i):
    """Return (flag name, values, next index) for the variadic flag at flags[i]."""
    name, sep, value = flags[i].partition('=')
    if sep:
        return name, [value], i + 1
    end = i + 1
    while end < len(flags) and not flags[end].startswith('-'):
        end += 1
    return name, flags[i + 1:end], end


def tool_names(values):
    return [n for v in values for n in v.replace(',', ' ').split()]


def guard_tool_search(flags):
    """Keep ToolSearch in --tools; skip MCP servers when tool search is off anyway. Returns (flags, notes)."""
    out, notes, search_off, i = [], [], False, 0
    # --strict-mcp-config without --mcp-config loads no MCP servers, so ToolSearch would only skew the run.
    no_mcp = '--strict-mcp-config' in flags and not any(f.split('=')[0] == '--mcp-config' for f in flags)
    while i < len(flags):
        name, values, end = split_flag(flags, i)
        names = tool_names(values)
        if name in TOOLS_FLAGS and not no_mcp and 'default' not in names and TOOL_SEARCH not in names:
            out += [name, ','.join(names + [TOOL_SEARCH])]
            notes.append(f'added {TOOL_SEARCH} to {name}')
        else:
            out += flags[i:end]
            search_off |= name in DISALLOWED_FLAGS and TOOL_SEARCH in names
        i = end
    if os.environ.get('ENABLE_TOOL_SEARCH', '').strip().lower() in OFF_VALUES:
        search_off = True
    if os.environ.get('ANTHROPIC_BASE_URL') and not os.environ.get('ENABLE_TOOL_SEARCH'):
        search_off = True
    if search_off and '--strict-mcp-config' not in out:
        out.append('--strict-mcp-config')
        notes.append('tool search is off, so added --strict-mcp-config')
    return out, notes


def inline_mcp_tools(events):
    """Count MCP servers whose tools go out in full: live servers in a session without ToolSearch."""
    init = next((e for e in events if e.get('type') == 'system' and e.get('subtype') == 'init'), {})
    if TOOL_SEARCH in (init.get('tools') or []):
        return 0
    return sum(s.get('status') in LIVE_MCP_STATUSES for s in init.get('mcp_servers') or [])


def without_flag(flags, flag):
    out, i = [], 0
    while i < len(flags):
        name, _, end = split_flag(flags, i)
        if name != flag:
            out += flags[i:end]
        i = end
    return out


def text_of(stream):
    return stream.decode(errors='replace') if isinstance(stream, bytes) else stream or ''


def startup_check(args, flags):
    """Start a variant against CHECK_MODEL. Returns (inline_mcp_tools count, None), or (None, reason) without init."""
    cwd = Path(tempfile.mkdtemp(prefix='check-', dir=args.out))
    # A fallback model would turn the rejected CHECK_MODEL call into a billed one.
    cmd = ['claude', '-p', 'ok', '--output-format', 'stream-json', '--verbose', '--no-session-persistence',
           '--max-turns', '1', *without_flag(flags, '--fallback-model'), '--model', CHECK_MODEL]
    try:
        proc = subprocess.run(cmd, cwd=cwd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=args.timeout)
        out, err = proc.stdout, proc.stderr
    except subprocess.TimeoutExpired as e:
        out, err = text_of(e.stdout), f'timed out after {args.timeout}s'
    finally:
        shutil.rmtree(cwd, ignore_errors=True)
    events = []
    for line in out.splitlines():
        try:
            events.append(json.loads(line))
        except ValueError:
            continue
    if not any(e.get('type') == 'system' and e.get('subtype') == 'init' for e in events):
        reason = next((line.strip() for line in err.splitlines() if line.strip()), 'no reason given')
        return None, reason[:200]
    return inline_mcp_tools(events), None


def read_events(path):
    events = []
    for line in path.read_text(errors='replace').splitlines():
        try:
            events.append(json.loads(line))
        except ValueError:
            continue
    return events


def mcp_state(events):
    init = next((e for e in events if e.get('type') == 'system' and e.get('subtype') == 'init'), {})
    return {s.get('name', '?'): s.get('status', '?') for s in init.get('mcp_servers') or []}


def run_once(args, prompt, flags, log, err):
    cwd = Path(tempfile.mkdtemp(prefix='cwd-', dir=args.out))
    # The prompt goes on stdin, so a pkill -f on its words cannot stop this claude run.
    # --prompt-file also keeps it off this script's own command line.
    cmd = ['claude', '-p', '--output-format', 'stream-json', '--verbose',
           '--no-session-persistence', '--max-turns', str(args.max_turns), *flags]
    start = time.monotonic()
    try:
        with open(log, 'w') as out, open(err, 'w') as errfh:
            proc = subprocess.run(cmd, cwd=cwd, input=prompt, text=True, stdout=out, stderr=errfh,
                                  timeout=args.timeout)
        code = proc.returncode
    except subprocess.TimeoutExpired:
        code = 'timeout'
    finally:
        if args.keep:
            print(f'kept {cwd}', file=sys.stderr)
        else:
            shutil.rmtree(cwd, ignore_errors=True)
    return code, time.monotonic() - start


def run(args, prompt, name, flags, index):
    log = args.out / f'{name}-{index}.jsonl'
    err = args.out / f'{name}-{index}.stderr'
    for attempt in range(1, args.retries + 2):
        code, secs = run_once(args, prompt, flags, log, err)
        events = read_events(log)
        mcp = mcp_state(events)
        waiting = sorted(n for n, s in mcp.items() if s in RETRY_STATUSES)
        if not waiting or attempt > args.retries:
            break
        print(f'{name} #{index}: MCP not ready ({", ".join(waiting)}); retry {attempt}/{args.retries}', file=sys.stderr)
    result = next((e for e in reversed(events) if e.get('type') == 'result'), {})
    status = 'ok' if code == 0 and not result.get('is_error') else f"{result.get('subtype') or 'exit'} {code}"
    inline = 0 if args.allow_inline_tools else inline_mcp_tools(events)
    if inline:
        status = f'tools of {inline} MCP servers sent in full (no {TOOL_SEARCH})'
    elif status != 'ok':
        reason = next((line.strip() for line in err.read_text(errors='replace').splitlines() if line.strip()), '')
        status += f': {reason[:80]}' if reason else ''
    return dict(variant=name, run=index, attempts=attempt, log=str(log), status=status, secs=secs,
                mcp=f"{sum(s == 'connected' for s in mcp.values())}/{len(mcp)}", mcp_waiting=waiting,
                turns=result.get('num_turns', 0), claude_usd=result.get('total_cost_usd'))


def add_usage(rows):
    tool = sessions_tool()
    if not tool:
        sys.exit('agent-probe: agt not found on PATH')
    out = subprocess.run([tool, 'sessions', 'report', '--sections', 'cost', '--by', 'file', '--json', *[r['log'] for r in rows]],
                         capture_output=True, text=True)
    if out.returncode:
        sys.exit(f'agent-probe: agt sessions failed: {out.stderr.strip()}')
    data = json.loads(out.stdout)
    by_file = {r['file']: r for r in data['rows']}
    for r in rows:
        u = by_file.get(r['log'], {})
        r.update(tools=u.get('tool_calls', 0), usd=u.get('usd', 0.0), **{k: u.get(k, 0) for k in
                 ('input_tokens', 'cache_creation_input_tokens', 'cache_read_input_tokens', 'output_tokens')})
    return data['unpriced']


def tok(n):
    return f'{n / 1e3:.1f}k' if n >= 1000 else str(int(n))


def print_table(rows):
    headers = ['variant', 'run', 'tries', 'mcp', 'turns', 'tools', 'in', 'write', 'read', 'out', 'USD', 'claude USD', 'secs', 'status']
    lines = []
    for r in rows:
        lines.append([r['variant'], str(r['run']), str(r['attempts']), r['mcp'], str(r['turns']), str(r['tools']),
                      tok(r['input_tokens']), tok(r['cache_creation_input_tokens']), tok(r['cache_read_input_tokens']),
                      tok(r['output_tokens']), f"{r['usd']:.4f}",
                      '-' if r['claude_usd'] is None else f"{r['claude_usd']:.4f}", f"{r['secs']:.0f}", r['status']])
    variants = list(dict.fromkeys(r['variant'] for r in rows))
    for v in variants:
        group = [r for r in rows if r['variant'] == v]
        if len(group) < 2:
            continue
        def mean(key):
            return statistics.mean(r[key] for r in group)
        lines.append([v, 'mean', '', '', f"{mean('turns'):.1f}", f"{mean('tools'):.1f}", tok(mean('input_tokens')),
                      tok(mean('cache_creation_input_tokens')), tok(mean('cache_read_input_tokens')),
                      tok(mean('output_tokens')), f"{mean('usd'):.4f}", '', f"{mean('secs'):.0f}", ''])
    widths = [max(len(x) for x in col) for col in zip(headers, *lines)]
    for i, line in enumerate([headers, ['-' * w for w in widths]] + lines):
        print('  '.join(c.ljust(w) if j in (0, 13) else c.rjust(w) for j, (c, w) in enumerate(zip(line, widths))).rstrip())


def main():
    p = argparse.ArgumentParser(prog='agent-probe', description=__doc__.split('\n')[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split('\n\n', 1)[1])
    src = p.add_mutually_exclusive_group(required=True)
    src.add_argument('--prompt', help='prompt text')
    src.add_argument('--prompt-file', type=Path, help='file holding the prompt')
    p.add_argument('--variant', action='append', type=parse_variant, default=[],
                   help="NAME=ARGS: extra claude flags, e.g. off='--settings off.json' (default: base=)")
    p.add_argument('-n', '--runs', type=int, default=1, help='runs per variant (default 1)')
    p.add_argument('--max-turns', type=int, default=3, help='claude --max-turns (default 3)')
    p.add_argument('--retries', type=int, default=3, help='reruns while MCP servers are pending or failed (default 3)')
    p.add_argument('--timeout', type=int, default=600, help='seconds per run (default 600)')
    p.add_argument('--out', type=Path, help=f'log directory (default {SCRATCH}/<time>)')
    p.add_argument('--keep', action='store_true', help='keep the working directories')
    p.add_argument('--allow-inline-tools', action='store_true',
                   help='leave --tools and MCP servers as given, even if MCP tools would be sent in full')
    p.add_argument('--json', action='store_true', help='print rows as JSON')
    args = p.parse_args()
    if args.runs < 1:
        p.error('--runs must be at least 1')
    if not shutil.which('claude'):
        sys.exit('agent-probe: claude not found on PATH')
    prompt = args.prompt if args.prompt is not None else args.prompt_file.read_text()
    args.out = (args.out or SCRATCH / datetime.now().strftime('%Y%m%d-%H%M%S')).expanduser().resolve()
    args.out.mkdir(parents=True, exist_ok=True)
    variants = args.variant or [('base', [])]
    if len({n for n, _ in variants}) != len(variants):
        p.error('variant names must be unique')
    if not args.allow_inline_tools:
        guarded = []
        for name, flags in variants:
            flags, notes = guard_tool_search(flags)
            for note in notes:
                print(f'{name}: {note}', file=sys.stderr)
            guarded.append((name, flags))
        variants = guarded
        failed = []
        for name, flags in variants:
            print(f'checking {name} at startup', file=sys.stderr)
            inline, reason = startup_check(args, flags)
            if inline is None:
                failed.append(f'{name}: claude printed no tool list: {reason}')
            elif inline:
                fix = ('turn tool search on or drop --mcp-config' if '--strict-mcp-config' in flags
                       else 'add --strict-mcp-config')
                failed.append(f'{name}: no {TOOL_SEARCH}, so tools of {inline} MCP servers would be sent in full;'
                              f' {fix}, or pass --allow-inline-tools')
        if failed:
            sys.exit('agent-probe: nothing ran.\n  ' + '\n  '.join(failed))
    rows = []
    # Interleave variants so drift over time (cache warmth, load) spreads evenly across them.
    for index in range(1, args.runs + 1):
        for name, flags in variants:
            print(f'running {name} #{index}', file=sys.stderr)
            rows.append(run(args, prompt, name, flags, index))
    unpriced = add_usage(rows)
    if args.json:
        json.dump(rows, sys.stdout, indent=1)
        print()
    else:
        print_table(rows)
        if unpriced:
            print('Unpriced models (add them to the price file):', unpriced)
        print(f'Logs: {args.out}')
    if any(r['status'] != 'ok' or r['mcp_waiting'] for r in rows):
        sys.exit(1)


if __name__ == '__main__':
    main()
