#!/bin/sh
# Chrome for Testing for browser automation (chrome-devtools-mcp).
# Installed Google Chrome copies itself into the user temp X folder on each launch and
# deletes the copy only on a clean quit; agent sessions kill it, so about 1.4 GiB leaks
# per launch. Chrome for Testing makes no such copy.
#   chrome-for-testing install   download the current Stable build and drop older ones not in use
#   chrome-for-testing path      print the executable path; exit 1 when not installed
#   chrome-for-testing [args]    run it
# `path` and runs start a background install when the last check is a week old (or nothing is
# installed), so launches never wait on a download; the next launch uses the new build.
set -eu

root="${XDG_DATA_HOME:-$HOME/.local/share}/chrome-for-testing"

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) platform=mac-arm64 bin="Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing" ;;
  Darwin-x86_64) platform=mac-x64 bin="Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing" ;;
  Linux-x86_64) platform=linux64 bin=chrome ;;
  *) echo "chrome-for-testing: unsupported platform $(uname -sm)" >&2; exit 1 ;;
esac

exe() {
  version=$(cat "$root/current" 2>/dev/null) || return 1
  path="$root/$version/chrome-$platform/$bin"
  [ -x "$path" ] || return 1
  printf '%s\n' "$path"
}

# Deletes versions other than the current one, keeping any that a running browser still uses:
# deleting those would crash the session when Chrome starts its next helper process.
prune() {
  keep=$(cat "$root/current" 2>/dev/null) || return 0
  running=$(ps -axo command=)
  for dir in "$root"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    [ "$name" = "$keep" ] && continue
    if printf '%s\n' "$running" | grep -qF "$root/$name/"; then
      echo "chrome-for-testing $name is still running; kept"
      continue
    fi
    rm -rf "${root:?}/$name"
    echo "chrome-for-testing $name removed"
  done
}

# One install at a time: two would replace the same version folder under each other. A lock whose
# process is gone is taken over.
lock() {
  mkdir -p "$root"
  lockdir="$root/.install.lock"
  if ! mkdir "$lockdir" 2>/dev/null; then
    holder=$(cat "$lockdir/pid" 2>/dev/null || true)
    if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
      echo "chrome-for-testing: another install (pid $holder) is running; skipped"
      exit 0
    fi
    rm -rf "$lockdir"
    mkdir "$lockdir" 2>/dev/null || { echo "chrome-for-testing: another install just started; skipped"; exit 0; }
  fi
  printf '%s\n' "$$" > "$lockdir/pid"
}

install() {
  lock
  tmp=
  trap 'rm -rf "$lockdir" ${tmp:+"$tmp"}' EXIT
  # Holding the lock means any download folder is left from a killed install.
  find "$root" -mindepth 1 -maxdepth 1 -name '.download.*' -exec rm -rf {} +
  touch "$root/.checked"
  feed=https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json
  json=$(curl -fsSL "$feed")
  version=$(printf '%s' "$json" | jq -r '.channels.Stable.version')
  url=$(printf '%s' "$json" | jq -r --arg p "$platform" \
    '.channels.Stable.downloads.chrome[] | select(.platform == $p) | .url')
  [ -n "$version" ] && [ -n "$url" ] || { echo "chrome-for-testing: no Stable build for $platform" >&2; exit 1; }
  if [ "$(cat "$root/current" 2>/dev/null)" = "$version" ] && exe >/dev/null; then
    echo "chrome-for-testing $version is current"
    prune
    return
  fi
  mkdir -p "$root"
  tmp=$(mktemp -d "$root/.download.XXXXXX")
  curl -fsSL -o "$tmp/chrome.zip" "$url"
  # ditto keeps the framework symlinks that the app needs on macOS.
  if command -v ditto >/dev/null; then
    ditto -x -k "$tmp/chrome.zip" "$tmp/out"
  else
    unzip -q "$tmp/chrome.zip" -d "$tmp/out"
  fi
  [ -x "$tmp/out/chrome-$platform/$bin" ] || { echo "chrome-for-testing: download is missing $bin" >&2; exit 1; }
  rm -rf "${root:?}/$version"
  mv "$tmp/out" "$root/$version"
  printf '%s\n' "$version" > "$root/current"
  echo "chrome-for-testing $version installed"
  prune
}

# Starts a detached install when the last check is over 7 days old. Its output goes to a log:
# callers capture `path` with $(...), which would otherwise wait for it, and the MCP server's
# stdout is its protocol channel.
refresh() {
  [ -n "$(find "$root/.checked" -mtime -7 2>/dev/null)" ] && return 0
  mkdir -p "$root" && touch "$root/.checked"
  nohup sh "$0" install >"$root/.install.log" 2>&1 </dev/null &
}

case "${1:-}" in
  install) install ;;
  path) refresh; exe ;;
  *) refresh
     path=$(exe) || { echo "chrome-for-testing: not installed yet; an install started in the background" >&2; exit 1; }
     exec "$path" "$@" ;;
esac
