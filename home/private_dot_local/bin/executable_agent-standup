#!/bin/bash
# Prints an end-of-day standup built from today's Claude sessions. Run it by hand.
# Usage: agent-standup

SLACK_USER=${AGENT_STANDUP_SLACK_USER:-U08NMC14XFB}
MODEL=${AGENT_STANDUP_MODEL:-opus}

STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/agents/standup
# Claude runs from here so its own sessions are easy to exclude from the digest.
RUN_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/agents/standup
TODAY=$(date +%F)
LOG=$STATE_DIR/log
mkdir -p "$STATE_DIR" "$RUN_DIR"

log() {
    echo "$(date '+%F %T') $*" >>"$LOG"
}

midnight() {
    date -j -v0H -v0M -v0S +%s
}

ask_claude() {
    local tools=$1 prompt=$2
    (cd "$RUN_DIR" && claude -p "$prompt" --model "$MODEL" --effort medium \
        --allowedTools "$tools" 2>>"$LOG")
}

# Repository name for a session, so worktrees of one repo share a label.
session_project() {
    local cwd common
    cwd=$(jq -r 'select(.cwd) | .cwd' "$1" 2>/dev/null | head -1)
    [ -z "$cwd" ] && { basename "$(dirname "$1")"; return; }
    [ "$cwd" = "$HOME" ] && { echo "none (home directory)"; return; }
    common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    case $common in
        */.git) basename "${common%/.git}" ;;
        # A removed worktree: name its repository, not the worktree.
        '') cwd=${cwd%%/.worktrees/*}; basename "${cwd%%/.claude/worktrees/*}" ;;
        *) basename "$common" .git ;;
    esac
}

# User prompts and final replies from today's Claude sessions.
session_digest() {
    local since exclude prompts
    since=$(date -u -r "$(midnight)" +%Y-%m-%dT%H:%M:%S)
    exclude=$(echo "$RUN_DIR" | tr '/.' '--')
    find "$HOME"/.claude*/projects -maxdepth 2 -name '*.jsonl' -newermt "$TODAY 00:00" \
        ! -path '*/subagents/*' ! -path "*/$exclude/*" 2>/dev/null | while read -r f; do
        # Headless runs (briefs, routines, scripts) are not work the user did.
        grep -q '"entrypoint":"cli"' "$f" || continue
        prompts=$(jq -r --arg since "$since" '
            select(.timestamp >= $since and .type == "user" and (.isMeta | not))
            | .message.content
            | if type == "string" then . else (.[]? | select(.type == "text") | .text) end
            | .[0:300] | gsub("\n"; " ")' "$f" 2>/dev/null |
            grep -v -e '<command-' -e '<local-command' -e 'system-reminder' -e 'task-notification' |
            head -40)
        # Sessions with no prompts today did no work today.
        [ -z "$prompts" ] && continue
        echo "=== project: $(session_project "$f")"
        echo "$prompts"
        # Final replies get truncated, so collect every link the session mentioned.
        echo "LINKS: $(jq -r --arg since "$since" 'select(.timestamp >= $since and .type == "assistant") | .message.content[]? | select(.type == "text") | .text' "$f" 2>/dev/null |
            grep -oE 'https://(gitlab\.com|jwplayer\.atlassian\.net|github\.com)/[^] )>|"`*,]+' | sed 's/[.:;]*$//' | sort -u | tr '\n' ' ')"
        echo "LAST: $(jq -r --arg since "$since" 'select(.timestamp >= $since and .type == "assistant") | .message.content[]? | select(.type == "text") | .text' "$f" 2>/dev/null | tail -c 1500 | tr '\n' ' ')"
    done
}

# Today's merge request actions from the GitLab event feed, with live state.
gitlab_digest() {
    local since events
    command -v glab >/dev/null || return
    since=$(date -u -r "$(midnight)" +%Y-%m-%dT%H:%M:%S)
    events=$(for page in 1 2 3; do
        glab api "events?after=$(date -v-1d +%F)&per_page=100&page=$page" 2>>"$LOG"
    done | jq -s --arg since "$since" '
        add // [] | map(select(.created_at >= $since))
        | map(if .target_type == "MergeRequest" then {project_id, iid: .target_iid, action: .action_name}
              elif .note.noteable_type == "MergeRequest" then {project_id, iid: .note.noteable_iid, action: "commented on"}
              else empty end)
        | group_by([.project_id, .iid])
        | map({project_id: .[0].project_id, iid: .[0].iid, actions: (map(.action) | unique)})')
    if [ -n "$events" ] && [ "$(echo "$events" | jq length)" != 0 ]; then
        echo "=== GitLab merge requests the user acted on today (state is live)"
        echo "$events" | jq -r '.[] | "\(.project_id) \(.iid) \(.actions | join(","))"' |
            while read -r project iid actions; do
                glab api "projects/$project/merge_requests/$iid" 2>>"$LOG" |
                    jq -r --arg a "$actions" 'select(.web_url) | "\(.web_url) [\(.state)] user: \($a) | \(.title)"'
            done
    fi
    # Claude Tag opens MRs as a GitLab service account and adds the requester as reviewer.
    local me tagged
    me=$(glab api user 2>>"$LOG" | jq -r '.username // empty')
    [ -z "$me" ] && return
    tagged=$(glab api "merge_requests?scope=all&reviewer_username=$me&updated_after=${since}Z&per_page=100" 2>>"$LOG" |
        jq -r 'if type == "array" then .[] else empty end
            | select(.author.username | startswith("service_account_"))
            | "\(.web_url) [\(.state)] | \(.title)"')
    [ -n "$tagged" ] && printf '=== Claude Tag merge requests with the user as reviewer, updated today (state is live)\n%s\n' "$tagged"
}

sources="The digest's GitLab sections list the merge requests the user acted on today and the Claude Tag merge requests where the user is reviewer, with live state; trust that state over session text. Claude Tag work counts as the user's work; label it 'via Claude' when useful. Also gather two more sources with your tools, then merge all sources into one standup without duplicates:
- Slack: slack_search_public_and_private with filters 'from:<@$SLACK_USER> on:$TODAY'. Ignore the user's DM with themself, including standups and morning briefs. Use only messages that show work: answers, decisions, help given, reviews, announcements. When a message asks Claude to do something (Claude Tag), read that thread with slack_read_thread and use Claude's outcome.
- Jira: getAccessibleAtlassianResources for the cloudId, then searchJiraIssuesUsingJql with jql 'status CHANGED BY currentUser() AFTER startOfDay() OR fixVersion CHANGED BY currentUser() AFTER startOfDay() OR (reporter = currentUser() AND created >= startOfDay()) OR (assignee = currentUser() AND (status CHANGED AFTER startOfDay() OR assignee CHANGED AFTER startOfDay() OR created >= startOfDay()))'. Ticket creation, status moves, new assignments, and release assignments count as work; assigned tickets still open belong in Next.
If a tool fails, continue with the other sources."
read_tools="mcp__claude_ai_Slack__slack_search_public_and_private mcp__claude_ai_Slack__slack_read_thread mcp__claude_ai_Atlassian__getAccessibleAtlassianResources mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql mcp__claude_ai_Atlassian_MCP__getAccessibleAtlassianResources mcp__claude_ai_Atlassian_MCP__searchJiraIssuesUsingJql"

digest="$(session_digest)
$(gitlab_digest)"
# Not ${digest//[[:space:]]/}: macOS bash 3.2 takes minutes on a large digest.
if [ -z "$(printf %s "$digest" | tr -d '[:space:]')" ]; then
    log "no claude sessions or gitlab activity today; standup skipped"
    exit 0
fi

format="Format exactly: no sections, 3-12 bullets total, each bullet under 20 words and starting with '• \`TYPE\` ' (the type in backticks, so it shows as a badge), where TYPE is one of Planned, KTLO, or Reactive. Planned is committed roadmap work: features, planned tickets, and reviews of them. KTLO is keep-the-lights-on upkeep: releases, tooling, refactors, test and docs maintenance, dependency work. Reactive is unplanned work pulled in by a customer, an incident, or an urgent request. Pick one type per bullet. Put work still in progress or assigned and open in bullets of its own, starting 'Next:' after the type tag. Group bullets by project: an italic project label on its own line, such as '_hive_', then that project's bullets. A project is a repository: take its name from the session's 'project:' header or the MR URL path. Use the Jira project key for ticket-only work, and '_Other_' for work with no project or a 'none' project. Order projects by amount of work. Each MR bullet names the MR and says in plain words what it changed, using its title; each ticket bullet says what the ticket is about. Never add a PUBS or SERV key to an MR bullet when the MR's title already contains that key; add one only when the title lacks it and the sessions tie the MR to that ticket.Releases and release monitoring each get their own bullet. Say merged, shipped, or released only when a final reply states it; otherwise say opened, in review, or in progress. Group related sessions; skip trivia, tests of tooling, and anything without an outcome. Link every MR, ticket, pipeline, and release with Slack link syntax <url|label>, using labels like !1234, hive!1118, or PUBS-1234; take URLs from LINKS, and link a Jira key without one as <https://jwplayer.atlassian.net/browse/KEY|KEY>. Never put bare URLs or Markdown links. Adding an MR or ticket to a release does not mean it merged. No intro or outro."
intro="The input is a digest of today's work: the user's prompts and final replies from Claude Code sessions, plus GitLab activity. Write a standup"

standup=$(echo "$digest" | ask_claude "$read_tools" "$intro. Print only the standup; send it nowhere.
$sources
$format")
if [ -z "$(printf %s "$standup" | tr -d '[:space:]')" ]; then
    log "claude returned no standup"
    exit 1
fi
printf '%s\n' "$standup"
