#!/bin/sh
# agent-wait: wait for a check command to succeed, for at most --max seconds.
# Usage: agent-wait [--max SECONDS] [--every SECONDS] -- CHECK [ARGS...]
# Exit 0 when CHECK succeeds, 3 when --max passes first, 2 on bad usage.
# Agents run it with run_in_background so they wake within --max (default
# 270 s, under the 5-minute prompt cache) to check on a long job.
set -u
max=270 every=5
while [ $# -gt 0 ]; do
  case "$1" in
    --max) max="$2"; shift 2 ;;
    --every) every="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "agent-wait: unknown option $1" >&2; exit 2 ;;
  esac
done
[ $# -gt 0 ] || { echo "usage: agent-wait [--max S] [--every S] -- CHECK..." >&2; exit 2; }
start=$(date +%s)
while :; do
  if "$@" >/dev/null 2>&1; then
    echo "agent-wait: done after $(( $(date +%s) - start ))s"
    exit 0
  fi
  if [ $(( $(date +%s) - start )) -ge "$max" ]; then
    echo "agent-wait: still running after ${max}s; check the job and re-arm"
    exit 3
  fi
  sleep "$every"
done
