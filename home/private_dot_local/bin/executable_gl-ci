#!/usr/bin/env python3
"""GitLab CI triage: compare an MR's failing tests with recent default-branch pipelines.

Usage:
  gl-ci failures <mr> [-R group/project] [-n N]
  gl-ci wait <pipeline|mr> [-R group/project] [--sha SHA] [--interval SEC] [--timeout SEC]

<mr> is 123, !123, or an MR URL. <pipeline> is an id or a pipeline URL; wait
takes !123 or an MR URL for the MR's head pipeline. Without -R or a URL, the
project is the current directory's repository.

failures lists failed and retried jobs of the MR's head pipeline, the failing
specs in their logs (Playwright, WebdriverIO, Karma, Jest), and how often each
spec failed in the last N finished default-branch pipelines, including retried
attempts. Verdicts:
  new           never failed on the default branch
  pre-existing  also fails in the latest default-branch pipeline that ran the job
  flaky         passed on retry in the MR, or failed only in older or retried
                default-branch attempts (it may also have been fixed there)
  pending       its job's retry is still running
  unclear       its job's retry was canceled or skipped

wait polls until the pipeline finishes, then lists its failed jobs. With an MR,
it first waits for a pipeline on the MR's newest commit, or on --sha; right
after a push, pass --sha "$(git rev-parse HEAD)" because GitLab updates the MR
asynchronously. Exit codes: 0 success, 1 failed, canceled, skipped, or blocked
on a manual job, 2 usage or GitLab API error (wait retries 5 polls in a row
first), 3 timeout.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime

RUNNING = {'created', 'waiting_for_resource', 'preparing', 'pending', 'running', 'scheduled', 'canceling'}
URL = re.compile(r'https?://([^/]+)/(.+?)/-/(merge_requests|pipelines)/(\d+)')
ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
RUNNER_PREFIX = re.compile(r'^\d{4}-\d\d-\d\dT[\d:.]+Z \d+[OE]\+?\s?')
PW_COUNT = re.compile(r'^\s+\d+ (failed|flaky|passed|skipped|interrupted|did not run)\b')
# Playwright pads failure headers with a ─ ruler whose length depends on the line number; drop it.
PW_TEST = re.compile(r'^\s+(?:\d+\) )?\[[^\]]+\] › (\S+?):\d+:\d+ › (.+?)[\s─]*$')
API_RETRIES = 5
WDIO = re.compile(r'(FAILED|PASSED) in \S+ - file://(\S+)(?: \((\d+) retries\))?')
KARMA = re.compile(r'^\S.*?\([^)]*\) (.+?) FAILED$')
JEST = re.compile(r'^\s*● (?!Console)(.+?)\s*$')


class GlabError(Exception):
    pass


def fail(message):
    print(f'gl-ci: {message}', file=sys.stderr)
    sys.exit(2)


class Gitlab:
    def __init__(self, project, host=None):
        self.env = dict(os.environ, GITLAB_HOST=host) if host else None
        ref = urllib.parse.quote(project, safe='') if project else ':id'
        info = self.get(f'projects/{ref}')
        self.base = f"projects/{info['id']}"
        self.path = info['path_with_namespace']
        self.default_branch = info['default_branch']

    def call(self, path, paginate=False):
        cmd = ['glab', 'api', path] + (['--paginate'] if paginate else [])
        out = subprocess.run(cmd, capture_output=True, text=True, env=self.env)
        if out.returncode:
            raise GlabError(f'glab api {path} failed: {out.stderr.strip() or out.stdout.strip()}')
        return out.stdout

    def get(self, path, paginate=False):
        text, values, pos = self.call(path, paginate), [], 0
        decoder = json.JSONDecoder()
        # --paginate prints one JSON array per page back to back.
        while pos < len(text):
            if text[pos].isspace():
                pos += 1
                continue
            value, pos = decoder.raw_decode(text, pos)
            values.append(value)
        if not paginate:
            return values[0] if values else None
        return [item for page in values for item in (page if isinstance(page, list) else [page])]

    def jobs(self, pipeline):
        jobs = self.get(f'{self.base}/pipelines/{pipeline}/jobs?include_retried=true&per_page=100', paginate=True)
        by_name = {}
        for job in sorted(jobs, key=lambda j: j['id']):
            by_name.setdefault(job['name'], []).append(job)
        return by_name

    def trace(self, job_id):
        return self.call(f'{self.base}/jobs/{job_id}/trace')


def family(name):
    """Shards and parallel copies of one job share a family: `test-pw: [3]` and `test-x 4/10`."""
    return re.sub(r'(:\s*\[\d+\]|\s+\d+/\d+)$', '', name)


def parse_specs(trace, project_path):
    """Map spec -> 'failed' or 'flaky' from a job log."""
    specs, section = {}, None
    for raw in trace.splitlines():
        line = RUNNER_PREFIX.sub('', ANSI.sub('', raw)).rstrip('\r')
        count = PW_COUNT.match(line)
        if count:
            section = count.group(1) if count.group(1) in ('failed', 'flaky') else None
            continue
        test = PW_TEST.match(line)
        if section and test:
            specs[f'{test.group(1)} › {test.group(2)}'] = section
            continue
        if section and line.strip():
            section = None
        wdio = WDIO.search(line)
        if wdio:
            path = wdio.group(2).split(project_path + '/', 1)[-1]
            if wdio.group(1) == 'FAILED':
                specs[path] = 'failed'
            elif wdio.group(3) and int(wdio.group(3)) > 0:
                specs.setdefault(path, 'flaky')
            continue
        karma = KARMA.match(line)
        if karma and not line.startswith('Executed'):
            specs[karma.group(1)] = 'failed'
            continue
        jest = JEST.match(line)
        if jest:
            specs[jest.group(1)] = 'failed'
    return specs


def pipeline_failures(gl, by_name, families=None):
    """Failed attempts per job family in one pipeline.

    Returns {family: {'final_failed', 'any_failed': bool, 'running', 'unparsed', 'failed_jobs',
    'final_failed_jobs': set, 'specs': {spec: (state, final, job)}}}. final says whether the spec
    failed in the job's last attempt; running names jobs whose retry has not finished; unparsed
    names jobs whose failed last attempt shows no failed spec.
    """
    wanted = [(name, attempts) for name, attempts in by_name.items()
              if (families is None or family(name) in families) and any(a['status'] == 'failed' for a in attempts)]
    failed = [(name, a, a is attempts[-1]) for name, attempts in wanted for a in attempts if a['status'] == 'failed']
    with ThreadPoolExecutor(8) as pool:
        traces = list(pool.map(lambda item: gl.trace(item[1]['id']), failed))
    result = {}
    for (name, attempts) in wanted:
        entry = result.setdefault(family(name), {'final_failed': False, 'any_failed': True, 'running': set(), 'unparsed': set(),
                                                 'failed_jobs': set(), 'final_failed_jobs': set(), 'last_status': {}, 'specs': {}})
        entry['failed_jobs'].add(name)
        entry['last_status'][name] = attempts[-1]['status']
        if attempts[-1]['status'] == 'failed':
            entry['final_failed'] = True
            entry['final_failed_jobs'].add(name)
        if attempts[-1]['status'] in RUNNING:
            entry['running'].add(name)
    final_parsed, earlier = {}, set()
    for (name, attempt, final), trace in zip(failed, traces):
        entry = result[family(name)]
        parsed = parse_specs(trace, gl.path)
        if final:
            final_parsed[name] = parsed
            if not any(state == 'failed' for state in parsed.values()):
                entry['unparsed'].add(name)
        else:
            earlier.update((name, spec) for spec, state in parsed.items() if state == 'failed')
        for spec, state in parsed.items():
            old_state, old_final, _ = entry['specs'].get(spec, ('flaky', False, name))
            entry['specs'][spec] = ('failed' if 'failed' in (state, old_state) else 'flaky', old_final or (final and state == 'failed'), name)
    # When the last attempt failed without naming a spec (timeout, setup error), a spec that failed
    # earlier never passed on retry, unless the last attempt reports it as flaky or passed.
    for entry in result.values():
        for spec, (state, final, job) in list(entry['specs'].items()):
            if not final and job in entry['unparsed'] and (job, spec) in earlier and spec not in final_parsed.get(job, {}):
                entry['specs'][spec] = (state, True, job)
    return result


def runs_commit(gl, pipe, sha):
    """Whether the pipeline tested sha. Merged-results pipelines run on a merge commit whose parent is sha."""
    if not pipe or not pipe.get('sha'):
        return False
    if pipe['sha'] == sha:
        return True
    return sha in (gl.get(f"{gl.base}/repository/commits/{pipe['sha']}").get('parent_ids') or [])


def parse_target(value, kind):
    """Return (host, project, kind, number) for an id, !id, or GitLab URL."""
    m = URL.match(value)
    if m:
        return m.group(1), m.group(2), 'mr' if m.group(3) == 'merge_requests' else 'pipeline', int(m.group(4))
    m = re.fullmatch(r'(!?)(\d+)', value)
    if not m:
        fail(f'expected an id, !id, or URL, got {value!r}')
    return None, None, 'mr' if m.group(1) or kind == 'mr' else 'pipeline', int(m.group(2))


def connect(args, kind):
    host, project, target_kind, number = parse_target(args.target, kind)
    return Gitlab(args.repo or project, host), target_kind, number


def table(headers, rows):
    widths = [max([len(h)] + [len(str(r[i])) for r in rows]) for i, h in enumerate(headers)]
    for row in [headers, ['-' * w for w in widths]] + rows:
        print('  '.join(str(c).ljust(w) for c, w in zip(row, widths)).rstrip())


def cmd_failures(args):
    gl, kind, iid = connect(args, 'mr')
    if kind != 'mr':
        fail('failures takes an MR, not a pipeline')
    mr = gl.get(f'{gl.base}/merge_requests/{iid}')
    pipe = mr.get('head_pipeline')
    if not pipe:
        fail(f'!{iid} has no pipeline')
    print(f"!{iid} {mr['title']}\npipeline {pipe['id']} {pipe['status']} for {mr['sha'][:8]}: {pipe['web_url']}")
    if not runs_commit(gl, pipe, mr['sha']):
        print(f"⚠ newest commit {mr['sha'][:8]} has no pipeline yet; this one is older")
    print()
    by_name = gl.jobs(pipe['id'])
    flagged = {name: attempts for name, attempts in by_name.items() if any(a['status'] == 'failed' for a in attempts)}
    if not flagged:
        print('No failed or retried jobs.')
        return
    rows = []
    for name, attempts in flagged.items():
        final = attempts[-1]
        note = ' (allowed to fail)' if final.get('allow_failure') and final['status'] == 'failed' else ''
        rows.append([name, ' → '.join(a['status'] for a in attempts), final['status'] + note, final['web_url']])
    table(['job', 'attempts', 'final', 'log'], rows)

    mr_fail = pipeline_failures(gl, flagged)
    families = set(mr_fail)
    # Canceled and skipped pipelines say nothing about tests, so compare completed runs only.
    pipelines = [p for p in gl.get(f'{gl.base}/pipelines?ref={urllib.parse.quote(gl.default_branch)}'
                                   f'&scope=finished&per_page={min(100, args.n * 2)}')
                 if p['status'] in ('success', 'failed')][:args.n]
    def load(p):
        jobs = gl.jobs(p['id'])
        # Jobs that finished: rules, schedules, or path filters can leave a job out of a pipeline.
        ran = {name for name, attempts in jobs.items() if attempts[-1]['status'] in ('success', 'failed')}
        return pipeline_failures(gl, jobs, families), ran

    with ThreadPoolExecutor(4) as pool:
        loaded = list(pool.map(load, pipelines))
    history = [h for h, _ in loaded]
    total = len(history)
    print(f'\nCompared with the last {total} finished {gl.default_branch} pipelines '
          f"({pipelines[-1]['created_at'][:10]} to {pipelines[0]['created_at'][:10]}):" if total else
          f'\nNo finished {gl.default_branch} pipelines to compare.')

    rows = []
    for fam, info in sorted(mr_fail.items()):
        # A job whose failed last attempt names no spec (timeout, setup or lint error) is compared
        # with the same job name on the default branch.
        items = [(spec, (state, final, job), None) for spec, (state, final, job) in info['specs'].items()]
        items += [(f'(whole job {job})', ('failed', True, job), job) for job in sorted(info['unparsed'])]
        if not items:
            items = [(f'(whole job {fam})', ('flaky', False, None), '')]
        for spec, (state, final, job), whole in items:
            hits = [h.get(fam, {}) for h in history]
            # Compare with the newest pipeline that ran this job (or any job of the family).
            latest = next((h.get(fam, {}) for h, ran in loaded
                           if (whole in ran if whole else any(family(n) == fam for n in ran))), {})
            if whole is None:
                failed_in = [h for h in hits if spec in h.get('specs', {})]
                latest_final = latest.get('specs', {}).get(spec, (None, False))[1]
            elif whole:
                failed_in = [h for h in hits if whole in h.get('failed_jobs', ())]
                latest_final = whole in latest.get('final_failed_jobs', ())
            else:
                failed_in = [h for h in hits if h.get('any_failed')]
                latest_final = latest.get('final_failed')
            # A family-wide item (no job) checks every shard's last attempt.
            ends = [info['last_status'].get(job, 'success')] if job else list(info['last_status'].values())
            odd = [s for s in ends if s not in ('success', 'failed')]
            if not final and (job in info['running'] if job else info['running']):
                verdict, reason = 'pending', 'retry still running'
            elif not final and odd:
                verdict, reason = 'unclear', f'retry ended {odd[0]}'
            elif not final:
                verdict, reason = 'flaky', 'passed on retry in the MR'
            elif not failed_in:
                verdict, reason = 'new', ''
            elif latest_final:
                verdict, reason = 'pre-existing', f'fails in latest {gl.default_branch}'
            else:
                verdict, reason = 'flaky', f'failed in older or retried {gl.default_branch} runs'
            rows.append([verdict, f'{len(failed_in)}/{total}', fam, reason, spec])
    order = {'new': 0, 'pre-existing': 1, 'flaky': 2, 'unclear': 3, 'pending': 4}
    rows.sort(key=lambda r: (order[r[0]], r[2], r[4]))
    table(['verdict', gl.default_branch, 'job', 'why', 'spec'], rows)


def cmd_wait(args):
    gl, kind, number = connect(args, 'pipeline')
    mr_iid = number if kind == 'mr' else None
    deadline = time.monotonic() + args.timeout
    last, errors = None, 0
    while True:
        if time.monotonic() > deadline:
            print(f'gl-ci: timed out after {args.timeout}s', file=sys.stderr)
            sys.exit(3)
        try:
            if mr_iid:
                # GitLab updates the MR and its head_pipeline asynchronously after a push; until then
                # they describe the previous commit. --sha names the commit that was pushed.
                mr = gl.get(f'{gl.base}/merge_requests/{mr_iid}')
                head, sha = mr.get('head_pipeline'), args.sha or mr['sha']
                if not head and not args.sha:
                    fail(f'!{mr_iid} has no pipeline')
                matches = runs_commit(gl, head, sha)
                errors = 0
                if not matches:
                    if last != 'no-pipeline':
                        print(f"{datetime.now():%H:%M:%S} waiting for a pipeline on {sha[:8]}", flush=True)
                        last = 'no-pipeline'
                    time.sleep(args.interval)
                    continue
                number, mr_iid = head['id'], None
            pipe = gl.get(f'{gl.base}/pipelines/{number}')
            jobs = gl.jobs(number)
            errors = 0
        except GlabError as err:
            errors += 1
            print(f'gl-ci: {err} ({errors}/{API_RETRIES})', file=sys.stderr)
            if errors >= API_RETRIES:
                sys.exit(2)
            time.sleep(args.interval)
            continue
        finals = [attempts[-1] for attempts in jobs.values()]
        done = sum(j['status'] not in RUNNING for j in finals)
        state = (pipe['status'], done)
        if state != last:
            print(f"{datetime.now():%H:%M:%S} {pipe['status']} ({done}/{len(finals)} jobs finished) {pipe['web_url']}", flush=True)
            last = state
        if pipe['status'] not in RUNNING:
            break
        time.sleep(args.interval)
    failed = [[j['name'], j['stage'], j['web_url']] for j in finals if j['status'] == 'failed' and not j.get('allow_failure')]
    if failed:
        table(['failed job', 'stage', 'log'], failed)
    sys.exit(0 if pipe['status'] == 'success' else 1)


def main():
    p = argparse.ArgumentParser(prog='gl-ci', description=__doc__.split('\n')[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split('\n\n', 1)[1])
    sub = p.add_subparsers(dest='command', required=True)
    f = sub.add_parser('failures', help='failed jobs and specs of an MR versus the default branch')
    f.add_argument('target', metavar='mr')
    f.add_argument('-n', type=int, default=10, help='default-branch pipelines to compare (default 10)')
    f.set_defaults(func=cmd_failures)
    w = sub.add_parser('wait', help='poll a pipeline until it finishes')
    w.add_argument('target', metavar='pipeline')
    w.add_argument('--interval', type=int, default=30, help='seconds between polls (default 30)')
    w.add_argument('--timeout', type=int, default=3600, help='give up after this many seconds (default 3600)')
    w.add_argument('--sha', help='with an MR, wait for the pipeline of this commit (use after a push)')
    w.set_defaults(func=cmd_wait)
    for s in (f, w):
        s.add_argument('-R', '--repo', help='group/project (default: current repository or the URL)')
    args = p.parse_args()
    if getattr(args, 'n', 1) < 1:
        p.error('-n must be at least 1')
    try:
        args.func(args)
    except GlabError as err:
        print(f'gl-ci: {err}', file=sys.stderr)
        sys.exit(2)
    except BrokenPipeError:
        sys.stderr.close()


if __name__ == '__main__':
    main()
