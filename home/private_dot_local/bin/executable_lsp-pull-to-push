#!/usr/bin/env python3
"""Run an LSP server that only answers pull diagnostics for a client that reads pushed ones.

Usage: python3 -I lsp-pull-to-push <server command...>

Claude Code reads textDocument/publishDiagnostics. TypeScript 7 (`tsc --lsp`) only answers
textDocument/diagnostic requests. After each open, change, or save, this bridge pulls the
document's diagnostics and pushes them to the client. When the server asks for a refresh, it
pulls every open document again. Other messages pass through unchanged.
"""
import itertools
import json
import os
import subprocess
import sys
import threading

PULL_TRIGGERS = {"textDocument/didOpen", "textDocument/didChange", "textDocument/didSave"}
# ContentModified and ServerCancelled: the document changed while the server worked; pull again.
RETRY_CODES = {-32801, -32802}
MAX_RETRIES = 3


def read_message(stream):
    length = None
    while True:
        line = stream.readline()
        if not line:
            return None
        line = line.strip()
        if not line:
            break
        name, _, value = line.partition(b":")
        if name.strip().lower() == b"content-length":
            length = int(value)
    if length is None:
        return None
    return json.loads(stream.read(length))


class Writer:
    def __init__(self, stream):
        self.stream = stream
        self.lock = threading.Lock()

    def send(self, message):
        body = json.dumps(message, separators=(",", ":")).encode()
        with self.lock:
            self.stream.write(b"Content-Length: %d\r\n\r\n" % len(body) + body)
            self.stream.flush()


def main():
    server = subprocess.Popen(sys.argv[1:], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    to_server = Writer(server.stdin)
    to_client = Writer(sys.stdout.buffer)
    ids = itertools.count(1)
    pending = {}  # bridge request id -> (uri, document version when pulled, retries)
    versions = {}  # open document uri -> latest version sent to the server
    lock = threading.Lock()

    def pull(uri, retries=0):
        request_id = f"lsp-pull-to-push-{next(ids)}"
        with lock:
            pending[request_id] = (uri, versions.get(uri), retries)
        to_server.send({"jsonrpc": "2.0", "id": request_id, "method": "textDocument/diagnostic",
                        "params": {"textDocument": {"uri": uri}}})

    def from_server():
        while (message := read_message(server.stdout)) is not None:
            if message.get("method") == "workspace/diagnostic/refresh":
                # An edit can change other files' diagnostics; pull every open document again.
                to_server.send({"jsonrpc": "2.0", "id": message["id"], "result": None})
                with lock:
                    uris = list(versions)
                for uri in uris:
                    pull(uri)
                continue
            with lock:
                entry = pending.pop(message.get("id"), None) if "method" not in message else None
            if entry is None:
                to_client.send(message)
                continue
            uri, version, retries = entry
            error = message.get("error")
            if error:
                if error.get("code") in RETRY_CODES and retries < MAX_RETRIES:
                    pull(uri, retries + 1)
                continue
            with lock:
                # The document changed or closed since this pull; a newer pull follows the change.
                stale = version != versions.get(uri)
            report = message.get("result") or {}
            if not stale and report.get("kind") == "full":
                params = {"uri": uri, "diagnostics": report.get("items", [])}
                if version is not None:
                    params["version"] = version
                to_client.send({"jsonrpc": "2.0", "method": "textDocument/publishDiagnostics", "params": params})
        # The server is gone. Exit so the client sees it and can restart the server;
        # the main thread is still blocked reading the client.
        os._exit(server.wait())

    threading.Thread(target=from_server, daemon=True).start()

    stdin = sys.stdin.buffer
    while (message := read_message(stdin)) is not None:
        method = message.get("method")
        if method == "initialize":
            # Declare pull support so the server answers textDocument/diagnostic, and refresh
            # support so it says when other documents' diagnostics change. The bridge handles both.
            capabilities = message.setdefault("params", {}).setdefault("capabilities", {})
            capabilities.setdefault("textDocument", {}).setdefault("diagnostic", {"dynamicRegistration": False})
            capabilities.setdefault("workspace", {}).setdefault("diagnostics", {})["refreshSupport"] = True
        to_server.send(message)
        if method in PULL_TRIGGERS:
            document = message["params"]["textDocument"]
            uri = document["uri"]
            with lock:
                # Record the version only after forwarding the change, so a pull tagged with
                # it is answered from that change. didSave has no version; keep the last one.
                versions[uri] = document.get("version", versions.get(uri))
            pull(uri)
        elif method == "textDocument/didClose":
            uri = message["params"]["textDocument"]["uri"]
            with lock:
                versions.pop(uri, None)
            to_client.send({"jsonrpc": "2.0", "method": "textDocument/publishDiagnostics",
                            "params": {"uri": uri, "diagnostics": []}})
    server.stdin.close()
    sys.exit(server.wait())


if __name__ == "__main__":
    main()
