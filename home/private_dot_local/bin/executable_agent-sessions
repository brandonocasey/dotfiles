#!/usr/bin/env python3
"""Stats from Claude Code session transcripts in ~/.claude*/projects.

Usage: agent-sessions <command> [--days N | --since DATE] [--project TEXT] [--scratch] [options]

Commands:
  cost        USD by agent and model (--by agent,model,project,session,file; --json)
  agents      per agent type: runs, start and peak context, calls, USD
  tools       tool calls and the share of cost their results carry
  cache-gaps  idle gaps that expired the prompt cache, and what ran before them
  errors      tool errors grouped by tool and message
  denials     permission denials grouped by source and reason
  friction    interrupts, corrections, short replies, repeated prompts (--tsv for rows)

Prices come from ~/.config/agents/model-prices.json (override: AGENT_PRICES).
Scratch and probe projects are skipped unless --scratch is given.
"""
import argparse
import collections
import json
import os
import re
import statistics
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

HOME = Path.home()
PRICES = Path(os.environ.get('AGENT_PRICES') or HOME / '.config/agents/model-prices.json')
SCRATCH = re.compile(r'-cache-agents-scratch|-cache-claude-tmp|^-private-tmp|^-tmp')
USAGE_KEYS = ('input_tokens', 'cache_creation_input_tokens', 'cache_read_input_tokens', 'output_tokens')


class Transcript:
    def __init__(self, path, project, session, agent):
        self.path, self.project, self.session, self.agent = path, project, session, agent

    def records(self, since=''):
        with open(self.path, errors='replace') as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if since and rec.get('timestamp', since) < since:
                    continue
                yield rec

    def api_calls(self, since=''):
        """One (record, usage, model, tool calls) per API response.

        Transcripts write one record per content block, so tool_use blocks are counted across all
        records that share the response id.
        """
        calls, tools = {}, {}
        for rec in self.records(since):
            msg = rec.get('message') or {}
            if rec.get('type') != 'assistant' or not msg.get('usage') or msg.get('model') == '<synthetic>':
                continue
            key = msg.get('id') or id(rec)
            calls[key] = (rec, msg['usage'], msg.get('model', '?'))
            tools.setdefault(key, set()).update(
                b.get('id') for b in msg.get('content') or [] if isinstance(b, dict) and b.get('type') == 'tool_use')
        return [(*calls[k], len(tools[k])) for k in calls]


def transcripts(args):
    if args.files:
        for f in args.files:
            p = Path(f)
            yield Transcript(p, p.parent.name, p.stem, 'main')
        return
    roots = [Path(r).expanduser() for r in args.root] or sorted(p for p in HOME.glob('.claude*/projects') if p.is_dir())
    cutoff = time.mktime(time.strptime(args.since, '%Y-%m-%d'))
    skipped = 0
    for root in roots:
        for path in root.rglob('*.jsonl'):
            parts = path.relative_to(root).parts
            project = parts[0]
            if args.project and args.project not in project:
                continue
            if not args.scratch and SCRATCH.search(project):
                skipped += 1
                continue
            try:
                if path.stat().st_mtime < cutoff:
                    continue
            except OSError:
                continue
            agent = 'main'
            if 'subagents' in parts:
                try:
                    agent = json.loads(path.with_suffix('.meta.json').read_text()).get('agentType') or '?'
                except (OSError, ValueError):
                    agent = '?'
            elif len(parts) > 2:
                agent = 'other'
            yield Transcript(path, project, (parts[1] if len(parts) > 2 else path.stem)[:8], agent)
    if skipped:
        print(f'(skipped {skipped} scratch transcripts; --scratch includes them)', file=sys.stderr)


# --- pricing ---------------------------------------------------------------

def load_prices():
    try:
        return json.loads(PRICES.read_text())['models']
    except (OSError, ValueError, KeyError) as err:
        sys.exit(f'agent-sessions: cannot read prices from {PRICES}: {err}')


def model_rates(prices, model):
    keys = [k for k in prices if model == k or model.startswith(k + '-')]
    return prices[max(keys, key=len)] if keys else None


def usd(prices, model, usage):
    """USD parts {input, write, read, output} for one response, or None for an unpriced model."""
    base = model_rates(prices, model)
    if base is None:
        return None
    inp, cw, cr, out = (usage.get(k) or 0 for k in USAGE_KEYS)
    rates = base
    if 'over' in base and inp + cw + cr > base['over']['prompt_tokens']:
        rates = base['over']
    split = usage.get('cache_creation') or {}
    w5, w1 = split.get('ephemeral_5m_input_tokens'), split.get('ephemeral_1h_input_tokens')
    if w5 is None and w1 is None:
        w5, w1 = cw, 0
    mult = base.get('fast_multiplier', 1) if usage.get('speed') == 'fast' else 1
    scale = mult / 1e6
    return {
        'input': inp * rates['input'] * scale,
        'write': ((w5 or 0) * rates['write_5m'] + (w1 or 0) * rates['write_1h']) * scale,
        'read': cr * rates['read'] * scale,
        'output': out * rates['output'] * scale,
    }


# --- output ----------------------------------------------------------------

def tok(n):
    for div, unit in ((1e9, 'G'), (1e6, 'M'), (1e3, 'k')):
        if abs(n) >= div:
            return f'{n / div:.1f}{unit}'
    return str(int(n))


def table(headers, rows):
    rows = [[str(c) for c in r] for r in rows]
    widths = [max([len(h)] + [len(r[i]) for r in rows]) for i, h in enumerate(headers)]
    # Left-align the first column and any text column; right-align numbers.
    numeric = [i > 0 and all(re.fullmatch(r'[-$\d.,%kMG/]+', r[i] or '0') for r in rows) for i in range(len(headers))]
    for r in [headers, ['-' * w for w in widths]] + rows:
        print('  '.join(c.rjust(w) if numeric[i] else c.ljust(w) for i, (c, w) in enumerate(zip(r, widths))).rstrip())


# --- commands --------------------------------------------------------------

def cmd_cost(args):
    prices = load_prices()
    keys = args.by.split(',')
    groups = collections.defaultdict(collections.Counter)
    unpriced, fast = collections.Counter(), 0
    for t in transcripts(args):
        for _, u, model, ntools in t.api_calls(args.since_iso):
            fields = {'agent': t.agent, 'model': model, 'project': short_project(t.project), 'session': t.session, 'file': str(t.path)}
            g = groups[tuple(fields[k] for k in keys)]
            g['calls'] += 1
            g['tools'] += ntools
            for k in USAGE_KEYS:
                g[k] += u.get(k) or 0
            fast += u.get('speed') == 'fast'
            parts = usd(prices, model, u)
            if parts is None:
                unpriced[model] += 1
                continue
            for k, v in parts.items():
                g['usd_' + k] += v
    rows = []
    for key, g in groups.items():
        total = sum(v for k, v in g.items() if k.startswith('usd_'))
        rows.append(dict(zip(keys, key), calls=g['calls'], tool_calls=g['tools'],
                         **{k: g[k] for k in USAGE_KEYS}, usd=round(total, 4),
                         **{k: round(g[k], 4) for k in ('usd_input', 'usd_write', 'usd_read', 'usd_output')}))
    rows.sort(key=lambda r: -r['usd'])
    if args.json:
        json.dump({'rows': rows, 'unpriced': unpriced, 'fast_calls': fast}, sys.stdout, indent=1)
        print()
        return
    total = sum(r['usd'] for r in rows)
    grand = total or 1
    print(f'Total ${total:,.2f} since {args.since}' + (f' (project ~ {args.project})' if args.project else ''))
    table(keys + ['calls', 'in', 'write', 'read', 'out', 'USD', '%', 'write%', 'read%', 'out%'],
          [[r[k][-60:] for k in keys] + [r['calls'], tok(r['input_tokens']), tok(r['cache_creation_input_tokens']),
           tok(r['cache_read_input_tokens']), tok(r['output_tokens']), f"{r['usd']:,.2f}", f"{100 * r['usd'] / grand:.1f}"]
           + [f"{100 * r['usd_' + k] / (r['usd'] or 1):.0f}" for k in ('write', 'read', 'output')]
           for r in rows[:args.top]])
    if len(rows) > args.top:
        print(f'({len(rows) - args.top} more groups; --top raises the limit)')
    if unpriced:
        print('Unpriced models (add them to the price file):', dict(unpriced))
    if fast:
        print(f'Fast-mode calls: {fast}')


def cmd_agents(args):
    prices = load_prices()
    by = collections.defaultdict(list)
    for t in transcripts(args):
        calls = t.api_calls(args.since_iso)
        if not calls:
            continue
        ctx = [sum(u.get(k) or 0 for k in USAGE_KEYS[:3]) for _, u, _, _ in calls]
        cost = sum(sum((usd(prices, m, u) or {}).values()) for _, u, m, _ in calls)
        by[t.agent].append((ctx[0], max(ctx), len(calls), cost))
    rows = []
    for agent, runs in sorted(by.items(), key=lambda kv: -sum(r[3] for r in kv[1])):
        med = [statistics.median(r[i] for r in runs) for i in range(4)]
        rows.append([agent, len(runs), tok(med[0]), tok(med[1]), int(med[2]), f'{med[3]:.2f}', f'{sum(r[3] for r in runs):,.2f}'])
    table(['agent', 'runs', 'med start ctx', 'med peak ctx', 'med calls', 'med USD', 'total USD'], rows)


# Leading `cd DIR &&`, `cd DIR;`, and `VAR=value;` steps hide the command that did the work.
PREAMBLE = re.compile(r'^(?:(?:cd\s+\S+|[A-Za-z_]\w*=\S*)\s*(?:&&|;)\s*)+')


def short_project(name):
    home = str(HOME).replace('/', '-').replace('.', '-')
    return '~/' + name[len(home) + 1:] if name.startswith(home) else name


def tool_key(name, inp):
    if name == 'Bash':
        cmd = (inp.get('command') or '').strip()
        cmd = PREAMBLE.sub('', cmd)
        return 'Bash:' + os.path.basename(cmd.split()[0])[:20] if cmd else 'Bash'
    if name == 'Read':
        p = inp.get('file_path', '')
        return 'Read:' + ('skills/rules' if '/skills/' in p or '.claude' in p else 'code/other')
    if name.startswith('mcp__'):
        return 'mcp:' + name.split('__')[1]
    return name


def est_tokens(content):
    if isinstance(content, str):
        return len(content) / 4
    if isinstance(content, list):
        return sum(1600 if b.get('type') == 'image' else len(b.get('text', '')) / 4 if b.get('type') == 'text'
                   else len(json.dumps(b)) / 4 for b in content if isinstance(b, dict))
    return len(json.dumps(content)) / 4 if content else 0


def cmd_tools(args):
    # Relative cost units in multiples of the input price: a tool result is written to the cache
    # once and re-read on every later call until the next compaction.
    write, read, output = 2.0, 0.1, 5.0
    agg = collections.defaultdict(lambda: [0, 0.0, 0.0])
    grand = 0.0
    for t in transcripts(args):
        seen, pending, results, bounds, ncalls = set(), {}, [], [], 0
        for rec in t.records(args.since_iso):
            kind, msg = rec.get('type'), rec.get('message')
            if kind == 'system' and rec.get('subtype') == 'compact_boundary':
                bounds.append(ncalls)
            if not isinstance(msg, dict):
                continue
            if kind == 'assistant':
                if msg.get('id') and msg['id'] not in seen and msg.get('usage'):
                    seen.add(msg['id'])
                    ncalls += 1
                    u = msg['usage']
                    grand += (u.get('input_tokens') or 0) + (u.get('cache_creation_input_tokens') or 0) * write \
                        + (u.get('cache_read_input_tokens') or 0) * read + (u.get('output_tokens') or 0) * output
                for b in msg.get('content') or []:
                    if isinstance(b, dict) and b.get('type') == 'tool_use':
                        pending[b['id']] = tool_key(b.get('name', ''), b.get('input') or {}), est_tokens(json.dumps(b.get('input')))
            elif kind == 'user' and isinstance(msg.get('content'), list):
                for b in msg['content']:
                    if isinstance(b, dict) and b.get('type') == 'tool_result' and b.get('tool_use_id') in pending:
                        key, in_tok = pending.pop(b['tool_use_id'])
                        results.append((ncalls, est_tokens(b.get('content')), in_tok, key))
        bounds.append(ncalls)
        for at, res_tok, in_tok, key in results:
            later = next(e for e in bounds if e >= at) - at
            a = agg[key]
            a[0] += 1
            a[1] += res_tok
            a[2] += res_tok * (write + read * later) + in_tok * (output + read * later)
    rows = sorted(agg.items(), key=lambda kv: -kv[1][2])
    attributed = sum(v[2] for _, v in rows)
    print(f'Tool inputs and results carry {100 * attributed / (grand or 1):.0f}% of estimated cost since {args.since}')
    table(['tool', 'calls', 'avg result tok', 'share %'],
          [[k, v[0], int(v[1] / v[0]), f'{100 * v[2] / (grand or 1):.1f}'] for k, v in rows[:args.top]])


def parse_ts(s):
    return datetime.fromisoformat(s.replace('Z', '+00:00'))


def cmd_cache_gaps(args):
    prices = load_prices()
    tot = collections.Counter()
    per, cause, worst = collections.Counter(), collections.Counter(), []
    for t in transcripts(args):
        prev, last_tool, cur_id = None, None, None
        seen = set()
        for rec in t.records(args.since_iso):
            msg = rec.get('message') or {}
            if rec.get('type') != 'assistant':
                continue
            if msg.get('id') != cur_id:
                # A response without tool_use ends the turn, so a gap after it is user idle time.
                cur_id, last_tool = msg.get('id'), None
            for b in msg.get('content') or []:
                if isinstance(b, dict) and b.get('type') == 'tool_use':
                    i = b.get('input') or {}
                    last_tool = (b['name'] + ': ' + str(i.get('command') or i.get('description') or '')[:60]).replace('\n', ' ')
            u = msg.get('usage')
            if prev and msg.get('id') in seen:
                # Later records of the same response carry its tool_use; that tool runs during the gap.
                prev = (prev[0], prev[1], last_tool)
            if not u or msg.get('id') in seen or 'timestamp' not in rec or msg.get('model') == '<synthetic>':
                continue
            seen.add(msg.get('id'))
            ts = parse_ts(rec['timestamp'])
            cw, cr = u.get('cache_creation_input_tokens') or 0, u.get('cache_read_input_tokens') or 0
            if prev and (ts - prev[0]).total_seconds() > args.gap * 60:
                tot['gaps'] += 1
                if cr < 0.5 * prev[1]:
                    tot['expired'] += 1
                    tot['rewrite_tokens'] += cw
                    tot['rewrite_usd'] += (usd(prices, msg.get('model', '?'), {'cache_creation_input_tokens': cw}) or {}).get('write', 0)
                    per[(t.agent, t.project)] += cw
                    cause[prev[2] or '(no tool: waiting on the user)'] += 1
                    worst.append(((ts - prev[0]).total_seconds() / 60, cw, rec['timestamp'][:16], t.project, t.session, t.agent))
            prev = (ts, cr + cw, last_tool)
    print(f"Gaps over {args.gap} min: {tot['gaps']}; cache expired in {tot['expired']}; "
          f"rewritten {tok(tot['rewrite_tokens'])} tokens, about ${tot['rewrite_usd']:,.2f} (as 5m writes)")
    print('\nRewrite tokens by agent and project:')
    table(['agent', 'project', 'rewrite tok'], [[a, short_project(p), tok(v)] for (a, p), v in per.most_common(args.top)])
    print('\nTool running before the expired gap:')
    table(['count', 'tool'], [[v, k] for k, v in cause.most_common(args.top)])
    print('\nLargest rewrites:')
    table(['time', 'gap min', 'rewrite tok', 'agent', 'project', 'session'],
          [[w[2], f'{w[0]:.0f}', tok(w[1]), w[5], short_project(w[3]), w[4]] for w in sorted(worst, key=lambda w: -w[1])[:10]])


DENIALS = [
    (re.compile(r'denied by the Claude Code auto mode classifier\. Reason: (\[[^\]]+\]|[^.\n]{0,60})'), 'auto mode'),
    (re.compile(r"The user doesn't want to proceed"), 'user rejected'),
    (re.compile(r'denied by a built-in Claude Code safety check'), 'safety check'),
    (re.compile(r"don't ask mode"), "don't-ask mode"),
    (re.compile(r'hook', re.I), 'hook'),
]


def result_text(content):
    if isinstance(content, list):
        return ' '.join(b.get('text', '') for b in content if isinstance(b, dict))
    return content if isinstance(content, str) else ''


def tool_errors(args):
    """Yield (transcript, timestamp, tool name, input summary, error text) for every failed tool call."""
    for t in transcripts(args):
        uses = {}
        for rec in t.records(args.since_iso):
            msg = rec.get('message')
            if not isinstance(msg, dict) or not isinstance(msg.get('content'), list):
                continue
            for b in msg['content']:
                if not isinstance(b, dict):
                    continue
                if b.get('type') == 'tool_use':
                    i = b.get('input') or {}
                    uses[b.get('id')] = (b.get('name', '?'), str(i.get('command') or i.get('file_path') or i.get('url') or json.dumps(i))[:100])
                elif b.get('type') == 'tool_result' and b.get('is_error'):
                    name, summary = uses.get(b.get('tool_use_id'), ('?', ''))
                    yield t, rec.get('timestamp', ''), name, summary, result_text(b.get('content'))


def denial_kind(text):
    # A command that ran and failed is an error even when its output says "Permission denied".
    if text.lstrip().startswith('Exit code') or (
            'denied' not in text and 'rejected' not in text and "doesn't want to proceed" not in text):
        return None
    for pattern, label in DENIALS:
        m = pattern.search(text)
        if m:
            return f'{label}: {m.group(1).strip()}' if m.groups() else label
    return 'other' if re.search(r'Permission .{0,40}denied', text) else None


def grouped(rows, top):
    """rows: (key, session, timestamp, example). Print count, sessions, last date, key, example."""
    g = collections.defaultdict(lambda: [0, set(), '', ''])
    for key, session, ts, example in rows:
        e = g[key]
        e[0] += 1
        e[1].add(session)
        e[2] = max(e[2], ts[:10])
        e[3] = e[3] or example
    items = sorted(g.items(), key=lambda kv: -kv[1][0])
    print(f'{sum(v[0] for _, v in items)} total in {len({s for _, v in items for s in v[1]})} sessions')
    table(['count', 'sessions', 'last', 'group', 'example'],
          [[v[0], len(v[1]), v[2], k[:90], v[3][:70].replace('\n', ' ')] for k, v in items[:top]])


def cmd_errors(args):
    rows = []
    for t, ts, name, summary, text in tool_errors(args):
        if denial_kind(text):
            continue
        lines = [s.strip() for s in re.sub(r'</?tool_use_error>', '', text).split('\n') if s.strip()] or ['']
        # "Exit code N" alone says nothing; the next line is usually the error.
        first = ' | '.join(lines[:2]) if lines[0].startswith('Exit code') else lines[0]
        rows.append((f'{name}: ' + re.sub(r'\d+', '#', first)[:80], t.session, ts, summary))
    grouped(rows, args.top)


def cmd_denials(args):
    rows = []
    for t, ts, name, summary, text in tool_errors(args):
        kind = denial_kind(text)
        if kind:
            rows.append((kind, t.session, ts, f'{name}: {summary}'))
    grouped(rows, args.top)


CORRECTIONS = {
    'continue': r'^(continue|keep going|go on|proceed)\b',
    'you do it': r'\byou (do|run|paste|try|fix) (it|that|this)\b|^you do\b',
    'did you': r'\bdid you \w+',
    'eli5': r'\beli5\b',
    'status?': r'^status\b',
    'stop': r'^stop\b|\bstop \w+ing\b',
    'I meant': r'\bi meant\b',
    'again': r'\bagain\b|\bstill (broken|failing|wrong|not)\b',
}
CORRECTION_RE = {k: re.compile(v, re.I) for k, v in CORRECTIONS.items()}


def user_text(rec):
    """Text the user typed, or None for tool results and injected harness content."""
    if rec.get('type') != 'user' or rec.get('isMeta') or rec.get('isCompactSummary') \
            or str(rec.get('entrypoint', '')).startswith('sdk'):
        return None
    content = (rec.get('message') or {}).get('content')
    if isinstance(content, list):
        if any(isinstance(b, dict) and b.get('type') == 'tool_result' for b in content):
            return None
        content = ' '.join(b.get('text', '') for b in content if isinstance(b, dict) and b.get('type') == 'text')
    if not isinstance(content, str) or not content.strip():
        return None
    content = content.strip()
    cmd = re.search(r'<command-name>([^<]*)</command-name>', content)
    if cmd:
        cmd_args = re.search(r'<command-args>([^<]*)</command-args>', content)
        return (cmd.group(1) + ' ' + (cmd_args.group(1) if cmd_args else '')).strip()
    bash = re.match(r'<bash-input>(.*?)</bash-input>', content, re.S)
    if bash:
        return '! ' + bash.group(1).strip()
    if content.startswith(('<', 'Caveat:')):
        return None
    return content


def cmd_friction(args):
    msgs = []
    for t in transcripts(args):
        if t.agent != 'main':
            continue
        for rec in t.records(args.since_iso):
            text = user_text(rec)
            if text:
                msgs.append((rec.get('timestamp', '')[:10], t.project, t.session, text))
    if args.tsv:
        for m in msgs:
            print('\t'.join(m[:3] + (m[3].replace('\t', ' ').replace('\n', ' \\n ')[:args.width],)))
        return
    rows, short, norm = [], collections.defaultdict(list), collections.defaultdict(list)
    for day, project, session, text in msgs:
        flat = ' '.join(text.split())
        if flat.startswith('[Request interrupted'):
            rows.append(('interrupt' + (' (tool use)' if 'tool use' in flat else ''), session, day, short_project(project)))
            continue
        for label, pattern in CORRECTION_RE.items():
            if pattern.search(flat):
                rows.append((f'correction: {label}', session, day, flat))
        if len(flat.split()) <= 3:
            short[flat.lower()].append((session, day))
        norm[re.sub(r'[^\w\s/!-]', '', flat.lower())].append((session, day))
    print(f'{len(msgs)} user messages since {args.since}\n')
    print('Interrupts and corrections:')
    grouped(rows, args.top)
    print('\nShort replies (3 words or fewer), top 20:')
    table(['count', 'sessions', 'last', 'reply'],
          [[len(v), len({s for s, _ in v}), max(d for _, d in v), k[:60]] for k, v in sorted(short.items(), key=lambda kv: -len(kv[1]))[:20]])
    print('\nSame prompt in 3 or more sessions:')
    repeated = [(k, v) for k, v in norm.items() if len({s for s, _ in v}) >= 3]
    table(['count', 'sessions', 'last', 'prompt'],
          [[len(v), len({s for s, _ in v}), max(d for _, d in v), k[:70]] for k, v in sorted(repeated, key=lambda kv: -len(kv[1]))[:args.top]])


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--days', type=int, default=30, help='look back this many days (default 30)')
    common.add_argument('--since', help='start date YYYY-MM-DD (overrides --days)')
    common.add_argument('--project', help='only projects whose directory name contains this text')
    common.add_argument('--scratch', action='store_true', help='include scratch and probe projects')
    common.add_argument('--root', action='append', default=[], help='transcript root (default ~/.claude*/projects)')
    common.add_argument('--top', type=int, default=25, help='rows per table (default 25)')
    parser = argparse.ArgumentParser(prog='agent-sessions', description=__doc__.split('\n')[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split('\n\n', 1)[1])
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('cost', parents=[common], help='USD by agent and model')
    p.add_argument('--by', default='agent,model', help='comma list of agent, model, project, session, file')
    p.add_argument('--json', action='store_true')
    p.add_argument('files', nargs='*', help='price these transcript or stream-json files instead of the roots')
    p.set_defaults(func=cmd_cost)
    for name, func, text in (('agents', cmd_agents, 'per agent type context and cost'),
                             ('tools', cmd_tools, 'tool result cost share'),
                             ('errors', cmd_errors, 'tool errors'),
                             ('denials', cmd_denials, 'permission denials')):
        sub.add_parser(name, parents=[common], help=text).set_defaults(func=func)
    p = sub.add_parser('cache-gaps', parents=[common], help='expired prompt cache after idle gaps')
    p.add_argument('--gap', type=float, default=5, help='idle minutes that count as a gap (default 5)')
    p.set_defaults(func=cmd_cache_gaps)
    p = sub.add_parser('friction', parents=[common], help='user-message friction')
    p.add_argument('--tsv', action='store_true', help='print every user message: date, project, session, text')
    p.add_argument('--width', type=int, default=300, help='TSV text width (default 300)')
    p.set_defaults(func=cmd_friction)
    args = parser.parse_args()
    args.files = getattr(args, 'files', None)
    if args.since:
        try:
            datetime.strptime(args.since, '%Y-%m-%d')
        except ValueError:
            parser.error('--since needs YYYY-MM-DD')
    else:
        args.since = (datetime.now() - timedelta(days=args.days)).strftime('%Y-%m-%d')
    # Stream-json files from `claude -p` have no timestamps, so explicit files skip the date filter.
    args.since_iso = '' if args.files else args.since
    try:
        args.func(args)
    except BrokenPipeError:
        sys.stderr.close()


if __name__ == '__main__':
    main()
