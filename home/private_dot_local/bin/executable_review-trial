#!/usr/bin/env python3
"""Gate and report for the reviewer shadow trial: Fable, Sonnet, and Haiku beside Opus.

start   reserve a slot for a review of the current repository; prints `on <n>/<limit>` or `off <n>/<limit>`
status  print the same line without reserving a slot
report  per reviewer model: findings kept after verification, findings no other model found, killed findings, cost

Slots are `<UTC time>\\t<main checkout>` lines in $XDG_STATE_HOME/agents/review-trial/slots.tsv
(default ~/.local/state). `start` exits 2 when it is not in a git repository or cannot write the slot file.
"""
import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

SLOT_LIMIT = 20
MODEL_FAMILIES = ("opus", "fable", "sonnet", "haiku")
REVIEWER_ROLES = ("reviewer", "reviewer-fable")
DUPLICATE_REASON = re.compile(r"^duplicate of (\S+)")
COUNTED_SEVERITIES = ("high", "medium")
REPORT_COLUMNS = ("reviews", "found", "only", "high", "medium", "killed")


def fail(message):
    print(f"review-trial: {message}", file=sys.stderr)
    sys.exit(2)


def warn(message):
    print(f"review-trial: {message}", file=sys.stderr)


def slots_path():
    state_home = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    return Path(state_home) / "agents/review-trial/slots.tsv"


def parse_time(text):
    """Parse an ISO time; one without a zone counts as UTC."""
    parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)


def parse_slots(text):
    """Return (reserved at, main checkout) for each well-formed slot line."""
    slots = []
    for line in text.splitlines():
        reserved_at, _, repo = line.partition("\t")
        if not repo:
            continue
        try:
            slots.append((parse_time(reserved_at), Path(repo)))
        except ValueError:
            warn(f"skipped slot line with a bad time: {line}")
    return slots


def read_slots(path):
    return parse_slots(path.read_text(errors="replace")) if path.exists() else []


def main_checkout():
    git = subprocess.run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True, check=False,
    )
    if git.returncode != 0:
        fail(f"not in a git repository: {git.stderr.strip()}")
    return Path(git.stdout.strip()).parent


def gate_line(used):
    return f"{'on' if used < SLOT_LIMIT else 'off'} {used}/{SLOT_LIMIT}"


def reserve_slot(path, repo):
    """Append a slot unless the limit is reached, and return the gate line. The lock keeps two reviews from sharing the last slot."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a+", errors="replace") as slots_file:
            fcntl.flock(slots_file, fcntl.LOCK_EX)
            slots_file.seek(0)
            text = slots_file.read()
            used = len(parse_slots(text))
            if used >= SLOT_LIMIT:
                return gate_line(used)
            now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            line_break = "" if not text or text.endswith("\n") else "\n"
            slots_file.write(f"{line_break}{now}\t{repo}\n")
            return f"on {used + 1}/{SLOT_LIMIT}"
    except OSError as error:
        fail(f"cannot write {path}: {error}")


def model_family(model):
    return next((name for name in MODEL_FAMILIES if name in (model or "")), "other")


class TrialRun:
    """One review run whose first full pass has ended and had a code reviewer of each model family."""

    def __init__(self, repo, store, run, first_pass):
        self.repo, self.store, self.run, self.first_pass = repo, store, run, first_pass
        self.models = code_reviewer_models(first_pass)
        self.started_at = parse_time(first_pass["started_at"])
        self.ended_at = parse_time(first_pass["ended_at"])

    def contains(self, started_at, cwd):
        """True when a reviewer that started at `started_at` in `cwd` belongs to this run's first pass."""
        if not self.started_at <= started_at <= self.ended_at:
            return False
        return cwd == self.repo or self.repo in cwd.parents


def code_reviewer_models(first_pass):
    """Map reviewer ID to model family. The last Haiku entry is the writing-reviewer, which is left out."""
    reviewers = [r for r in first_pass.get("reviewers") or [] if r.get("id") != "fix"]
    haiku = [r for r in reviewers if model_family(r.get("model")) == "haiku"]
    if haiku:
        reviewers.remove(haiku[-1])
    return {r["id"]: model_family(r.get("model")) for r in reviewers}


def load_stores(repo):
    for store_file in sorted((repo / ".agt/reviews").glob("*.json")):
        try:
            store = json.loads(store_file.read_text())
        except (OSError, ValueError) as error:
            warn(f"skipped {store_file}: {error}")
            continue
        if isinstance(store, dict):
            yield store


def first_full_pass(run):
    return next((p for p in run.get("passes") or [] if p.get("kind") == "full"), None)


def is_trial_run(run, first_pass, since):
    models = set(code_reviewer_models(first_pass).values())
    return models >= set(MODEL_FAMILIES) and parse_time(run["started_at"]) >= since


def trial_runs(slots):
    """Return each trial run started in a slot's repository since that repository's first slot."""
    first_slot = {}
    for reserved_at, repo in slots:
        first_slot[repo] = min(reserved_at, first_slot.get(repo, reserved_at))
    runs = {}
    for repo, since in first_slot.items():
        for store in load_stores(repo):
            for trial in store_trial_runs(repo, store, since):
                runs[(repo, trial.run["id"])] = trial
    return list(runs.values())


def store_trial_runs(repo, store, since):
    for run in store.get("runs") or []:
        first_pass = first_full_pass(run)
        if not first_pass or not is_trial_run(run, first_pass, since):
            continue
        if not first_pass.get("ended_at"):
            warn(f"skipped run {run['id']}: its first pass has not ended")
            continue
        yield TrialRun(repo, store, run, first_pass)


def credit(counts, thread):
    counts["found"] += 1
    if thread.get("type") == "bug" and thread.get("severity") in COUNTED_SEVERITIES:
        counts[thread["severity"]] += 1


def first_pass_threads(trial):
    """Return this run's surviving findings by ID, and the model of each rejected finding."""
    kept, rejected_models = {}, []
    for thread in trial.store.get("threads") or []:
        finding = thread.get("finding") or {}
        model = trial.models.get(finding.get("reviewer"))
        in_first_pass = finding.get("run") == trial.run["id"] and finding.get("pass") == trial.first_pass["id"]
        if model is None or not in_first_pass:
            continue
        if str(thread.get("resolution") or "").startswith("rejected"):
            rejected_models.append(model)
        else:
            kept[thread["id"]] = (model, thread)
    return kept, rejected_models


def reviewer_of(finding_id):
    """`rv-ab12.c1p0.r2.f3` names reviewer `r2`."""
    parts = (finding_id or "").split(".")
    return parts[2] if len(parts) == 4 else None


def tally_run(trial, totals):
    kept, rejected_models = first_pass_threads(trial)
    for model in rejected_models:
        totals[model]["killed"] += 1
    shared_ids = set()
    for killed in trial.first_pass.get("killed") or []:
        model = trial.models.get(reviewer_of(killed.get("id")))
        if model is None:
            continue
        duplicate = DUPLICATE_REASON.match(killed.get("reason") or "")
        kept_id = duplicate.group(1).rstrip(".,;:)") if duplicate else None
        if kept_id in kept:
            credit(totals[model], kept[kept_id][1])
            shared_ids.add(kept_id)
        else:
            totals[model]["killed"] += 1
    for thread_id, (model, thread) in kept.items():
        credit(totals[model], thread)
        totals[model]["only"] += thread_id not in shared_ids
    for model in set(trial.models.values()):
        totals[model]["reviews"] += 1


def first_assistant_entry(transcript):
    with open(transcript, encoding="utf-8", errors="replace") as lines:
        for line in lines:
            entry = json.loads(line) if line.strip() else {}
            if entry.get("type") == "assistant":
                return entry
    return None


def reviewer_start(meta, transcript):
    """Return (started at, cwd, model family) of a reviewer's transcript, or None for another role or no reply yet."""
    if json.loads(meta.read_text()).get("agentType") not in REVIEWER_ROLES:
        return None
    entry = first_assistant_entry(transcript)
    if not (entry and entry.get("timestamp") and entry.get("cwd")):
        return None
    model = model_family((entry.get("message") or {}).get("model"))
    return parse_time(entry["timestamp"]), Path(entry["cwd"]), model


def reviewer_transcripts(since):
    """Yield (started at, cwd, model family, path) for each reviewer sub-agent transcript written since `since`."""
    for meta in Path.home().glob(".claude*/projects/*/*/subagents/agent-*.meta.json"):
        transcript = meta.with_name(meta.name[: -len(".meta.json")] + ".jsonl")
        try:
            if transcript.stat().st_mtime < since.timestamp():
                continue
            start = reviewer_start(meta, transcript)
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as error:
            warn(f"skipped {transcript}: {error}")
            continue
        if start:
            yield (*start, transcript)


def transcripts_by_model(trials, since):
    """Group (transcript, first-pass end) of the trial runs' reviewers by model family; each transcript counts once.

    When trial runs overlap, a transcript belongs to the one that started last.
    """
    grouped = defaultdict(list)
    for started_at, cwd, model, transcript in reviewer_transcripts(since):
        matches = (trial for trial in trials if model in trial.models.values() and trial.contains(started_at, cwd))
        trial = max(matches, key=lambda match: match.started_at, default=None)
        if trial:
            grouped[model].append((transcript, trial.ended_at))
    return grouped


def cost_by_model(grouped):
    """Price each model's first-pass transcript entries; a model is left out when they cannot be priced."""
    cost = {}
    with tempfile.TemporaryDirectory(prefix="review-trial-") as directory:
        for model, transcripts in grouped.items():
            try:
                cost[model] = first_pass_usd(transcripts, Path(directory) / model)
            except (OSError, ValueError) as error:
                warn(f"cost unknown for {model}: {error}")
    return cost


def first_pass_usd(transcripts, directory):
    """Price copies of the transcripts, cut at each first pass's end, with `agt sessions report`."""
    directory.mkdir()
    copies = []
    for index, (transcript, ended_at) in enumerate(transcripts):
        copies.append(str(directory / f"{index}.jsonl"))
        copy_entries_until(transcript, ended_at, copies[-1])
    agt = subprocess.run(
        ["agt", "sessions", "report", "--sections", "cost", "--by", "file", "--json", *copies],
        capture_output=True, text=True, check=False,
    )
    if agt.returncode != 0:
        raise ValueError(f"agt sessions report failed: {agt.stderr.strip()}")
    return sum(row.get("usd", 0) for row in json.loads(agt.stdout).get("rows") or [])


def copy_entries_until(transcript, ended_at, copy):
    """Copy the entries written up to `ended_at`. A reviewer continued into fix checks appends to the same transcript."""
    with open(transcript, encoding="utf-8", errors="replace") as entries, open(copy, "w", encoding="utf-8") as kept:
        for line in entries:
            if not line.strip():
                continue
            timestamp = json.loads(line).get("timestamp")
            if not timestamp or parse_time(timestamp) <= ended_at:
                kept.write(line)


def print_report(slots):
    trials = trial_runs(slots)
    totals = defaultdict(lambda: defaultdict(int))
    for trial in trials:
        tally_run(trial, totals)
    print(f"trial reviews: {len(trials)}; slots {gate_line(len(slots)).split(' ')[1]}")
    if not trials:
        return
    cost = cost_by_model(transcripts_by_model(trials, min(reserved_at for reserved_at, _ in slots)))
    print("\t".join(("model", *REPORT_COLUMNS, "usd")))
    for model in sorted(totals, key=lambda name: (MODEL_FAMILIES + ("other",)).index(name)):
        usd = f"{cost[model]:.2f}" if model in cost else "?"
        print("\t".join((model, *(str(totals[model][column]) for column in REPORT_COLUMNS), usd)))


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("command", choices=("start", "status", "report"))
    command = parser.parse_args().command
    path = slots_path()
    if command == "start":
        print(reserve_slot(path, main_checkout()))
    elif command == "status":
        print(gate_line(len(read_slots(path))))
    else:
        print_report(read_slots(path))


if __name__ == "__main__":
    main()
