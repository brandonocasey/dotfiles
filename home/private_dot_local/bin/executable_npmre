#!/usr/bin/env bash


pnpm=""
pkglock=""
skip_install=""
list=""

if ! command -v "npm" 2>/dev/null 1>/dev/null; then
  echo "npm must be installed to use this" 1>&2 && exit 1
fi

print_help() {
cat <<EOF
  Usage: npmre [--pnpm][--lock][--list]

  > node_modules removal and reinstall for workspaces and beyond

  -h, --help         show this help message
      --pnpm         use pnpm (requires pnpm-workspace.yaml in root for workspaces)
      --lock         remove package-lock.json (will also remove for workspaces)
  -s, --skip-install skip doing the install, just cleanup
  -l, --list         list workspaces and exit without doing anything
EOF

}

while [ $# -gt 0 ]; do
  arg="$1"; shift

  case "$arg" in

    (--help|-h) print_help && exit ;;
    (--pnpm) pnpm="true" ;;
    (--lock|--package-lock|--pkg-lock) pkglock="true" ;;
    (--skip-install|-s|--no-install) skip_install="true" ;;
    (--list|-l) list="true" ;;
    (*) print_help && echo "invalid argument $arg" 1>&2 && exit 1 ;;
  esac
done

root="$(find-root)"

cd "$root" || exit 1

DIRS=('.')

# Print workspace globs, one per line, from pnpm-workspace.yaml (WORKSPACE_SOURCE=pnpm)
# or package.json. Exclusions ("!glob") are skipped: only listed dirs are cleaned.
read_workspaces='
const fs = require("fs");
const unquote = value => value.trim().replace(/^(["\x27])(.*)\1$/, "$2");
let globs = [];
if (process.env.WORKSPACE_SOURCE === "pnpm") {
  const lines = fs.readFileSync("pnpm-workspace.yaml", "utf8").split(/\r?\n/);
  const start = lines.findIndex(line => /^packages:/.test(line));
  if (start !== -1) {
    const inline = lines[start].replace(/\s+#.*$/, "").match(/^packages:\s*\[(.*)\]\s*$/);
    if (inline) {
      globs = inline[1].split(",").map(unquote).filter(Boolean);
    } else {
      for (const line of lines.slice(start + 1)) {
        if (/^\s*(#.*)?$/.test(line)) continue;
        const item = line.match(/^\s+-\s+(.*)$/);
        if (!item) break;
        globs.push(unquote(item[1].replace(/\s+#.*$/, "")));
      }
    }
  }
} else {
  const workspaces = JSON.parse(fs.readFileSync("package.json", "utf8")).workspaces;
  globs = Array.isArray(workspaces) ? workspaces : (workspaces && workspaces.packages) || [];
  if (!Array.isArray(globs)) throw new Error("package.json workspaces must be an array or have a packages array");
}
for (const glob of globs) if (!glob.startsWith("!")) console.log(glob);
'

workspaces=""
if [ "$pnpm" ] && [ -f "./pnpm-workspace.yaml" ]; then
  workspaces="$(WORKSPACE_SOURCE=pnpm node -e "$read_workspaces")" || { echo "npmre: could not read pnpm-workspace.yaml" 1>&2; exit 1; }
elif [ -f "./package.json" ]; then
  workspaces="$(node -e "$read_workspaces")" || { echo "npmre: could not read package.json workspaces" 1>&2; exit 1; }
fi

if [ -n "$workspaces" ]; then
  while IFS= read -r line; do
    if [ -n "$line" ]; then
      # Expand globs like "packages/*" to actual directories
      for expanded in $line; do
        [ -d "$expanded" ] && DIRS+=("$expanded")
      done
    fi
  done <<< "$workspaces"
fi

if [ -n "$list" ]; then
  for d in "${DIRS[@]}"; do
    echo "$d"
  done
  exit 0
fi

if [ -n "$pnpm" ] && [ -z "$skip_install" ]; then
  if ! command -v "pnpm" 2>/dev/null 1>/dev/null; then
    npm i -g pnpm
  fi
fi

tmpdir="$(mktemp -d)"
mkdir -p "$tmpdir"

for d in "${DIRS[@]}"; do
  if [ -d "$d/node_modules" ]; then
    echo "Removing $d/node_modules"
    mkdir -p "$tmpdir/$d"
    mv "$d/node_modules" "$tmpdir/$d/node_modules"
  fi

  if [ -n "$pkglock" ]; then
    if [ -n "$pnpm" ] && [ -f "$d/pnpm-lock.yaml" ]; then
      echo "Removing $d/pnpm-lock.yaml"
      rm -f "$d/pnpm-lock.yaml"
    elif [ -f "$d/package-lock.json" ]; then
      echo "Removing $d/package-lock.json"
      rm -f "$d/package-lock.json"
    fi
  fi
done

rm -rf "$tmpdir" &
disown

if [ -z "$skip_install" ]; then
  if [ -n "$pnpm" ]; then
    pnpm i
  else
    npm i
  fi
fi
