#!/usr/bin/env bash
# TODO: file exlusion

#
# find_replace
#
# Find and replace recursivly from the current directory
#
find_replace() {
    if [ "$#" -lt "2" ]; then
        echo '    Usage:'
        echo '        fr term replacement optional:dir'
        echo
        echo '    Example:'
        echo '        fr cappuchino cappuccino .'
        echo
        return 1
    fi

    find="$1"; shift
    replace="$1"; shift
    dir="."
    if [ -n "$1" ]; then
        dir="$1"; shift
    fi

    local found=0 file tmp
    # NUL-separated names keep paths with spaces intact. Writing sed's output
    # back through a temp file keeps trailing newlines and the file's mode.
    while IFS= read -r -d '' file; do
        found=1
        echo "Doing find replace in $file"
        tmp="$(mktemp)"
        if ! sed "s~$find~$replace~g" "$file" > "$tmp" || { [ -s "$file" ] && [ ! -s "$tmp" ]; }; then
            echo "Failed to do find replace on $file, contents ended up null"
            rm -f "$tmp"
            continue
        fi
        cat "$tmp" > "$file"
        rm -f "$tmp"
    done < <(grep -lR --null "$find" "$dir" --exclude-dir 'node_modules' --exclude-dir '.git')
    if [ "$found" = 0 ]; then
        echo "Found no files with the term $find"
    fi
}

find_replace "$@"
