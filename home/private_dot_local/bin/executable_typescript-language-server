#!/bin/sh
# Claude Code's typescript-lsp plugin runs typescript-language-server --stdio in
# the directory Claude Code started in.
# TypeScript 7 ships its own server in tsc. Fall back to the legacy server with
# TypeScript 6 when the workspace has its own TypeScript below 6, or when a
# tsconfig uses options TypeScript 7 removed (baseUrl, node/node10 resolution)
# or silences their deprecation (ignoreDeprecations). Sub-projects up to 2 folders
# down count, and so do TypeScript hoisted into a parent folder and tsconfig files
# in parent folders up to the repository root.
legacy="${XDG_DATA_HOME:-$HOME/.local/share}/typescript-ls-legacy/node_modules/.bin/typescript-language-server"

# Prints the TypeScript package.json files that apply here: the nearest parent's
# and each sub-project's.
typescript_packages() {
  dir=$PWD
  while :; do
    if [ -f "$dir/node_modules/typescript/package.json" ]; then
      echo "$dir/node_modules/typescript/package.json"
      break
    fi
    [ "$dir" = / ] && break
    dir=$(dirname "$dir")
  done
  find . -maxdepth 3 \( -name dist -o -name build -o -name .git \) -prune -o \
    -name node_modules -type d -prune -print 2>/dev/null |
    while IFS= read -r modules; do
      if [ -f "$modules/typescript/package.json" ]; then
        echo "$modules/typescript/package.json"
      fi
    done
}

# Prints tsconfig files in parent folders up to the repository root, which
# sub-project configs often extend.
parent_tsconfigs() {
  dir=$PWD
  while [ ! -e "$dir/.git" ] && [ "$dir" != / ] && [ "$dir" != "$HOME" ]; do
    dir=$(dirname "$dir")
    for config in "$dir"/tsconfig*.json "$dir"/jsconfig.json; do
      if [ -f "$config" ]; then
        echo "$config"
      fi
    done
  done
}

use_legacy() {
  [ -x "$legacy" ] || return 1
  # TypeScript 6 deprecates what 7 removes, so its projects check the same under 7.
  typescript_packages | while IFS= read -r package; do
    major=$(sed -n 's/^ *"version": *"\([0-9]*\)\..*/\1/p' "$package" | head -n 1)
    if [ -n "$major" ] && [ "$major" -lt 6 ]; then
      echo "$package"
    fi
  done | grep -q . && return 0
  # Sub-project and parent tsconfigs count too; skip dependency and build folders
  # and commented-out options.
  {
    find . -maxdepth 3 \( -name node_modules -o -name dist -o -name build -o -name .git \) -prune -o \
      \( -name 'tsconfig*.json' -o -name jsconfig.json \) -type f -print 2>/dev/null
    parent_tsconfigs
  } | while IFS= read -r config; do
    if grep -Eiq '^[[:space:]]*("baseUrl"|"moduleResolution"[[:space:]]*:[[:space:]]*"node(10)?"|"ignoreDeprecations")' "$config"; then
      echo "$config"
    fi
  done | grep -q .
}

if use_legacy; then
  exec "$legacy" "$@"
fi
# TypeScript 7 only answers pull diagnostics; the bridge pushes them to Claude Code.
exec python3 -I "$HOME/.local/bin/lsp-pull-to-push" tsc --lsp "$@"
