#!/bin/sh
# Claude Code's typescript-lsp plugin runs typescript-language-server --stdio.
# TypeScript 7 ships its own server in tsc. Fall back to the legacy server with
# TypeScript 6 when the workspace has its own TypeScript below 6, or when a
# tsconfig up to 3 levels down uses options TypeScript 7 removed (baseUrl, node/node10 resolution)
# or silences their deprecation (ignoreDeprecations).
legacy="${XDG_DATA_HOME:-$HOME/.local/share}/typescript-ls-legacy/node_modules/.bin/typescript-language-server"

use_legacy() {
  [ -x "$legacy" ] || return 1
  # TypeScript 6 deprecates what 7 removes, so its projects check the same under 7.
  ts_major=$(sed -n 's/^ *"version": *"\([0-9]*\)\..*/\1/p' node_modules/typescript/package.json 2>/dev/null | head -n 1)
  [ -n "$ts_major" ] && [ "$ts_major" -lt 6 ] && return 0
  # Sub-project tsconfigs count too; skip dependency and build folders.
  find . -maxdepth 3 \( -name node_modules -o -name dist -o -name build -o -name .git \) -prune -o \
    \( -name 'tsconfig*.json' -o -name jsconfig.json \) -type f \
    -exec grep -Eil '"baseUrl"|"moduleResolution"[[:space:]]*:[[:space:]]*"node(10)?"|"ignoreDeprecations"' {} + 2>/dev/null |
    grep -q .
}

if use_legacy; then
  exec "$legacy" "$@"
fi
# TypeScript 7 only answers pull diagnostics; the bridge pushes them to Claude Code.
exec python3 -I "$HOME/.local/bin/lsp-pull-to-push" tsc --lsp "$@"
