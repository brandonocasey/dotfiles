{
  "description": "Keep tmux session names aligned with Codex thread names; prune stale agent scratch dirs.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "fish -c 'codex-tmux-session'",
            "async": true,
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/prune-agent-dirs.sh",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "fish -c 'codex-tmux-session'",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ]
  }
}
