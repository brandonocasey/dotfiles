# Prompt before writes the user wants to approve. Codex rules match command
# prefixes only: no globs, and no "outside scratch" test for rm.
# Needs approval_policy = "on-request"; "never" turns prompt into forbidden.
# Not matched: flags after the remote, `+branch`, `--force-with-lease=<ref>`.

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Merging a PR needs explicit approval.",
    match = [["gh", "pr", "merge", "12"]],
)

prefix_rule(
    pattern = ["glab", "mr", ["approve", "merge"]],
    decision = "prompt",
    justification = "Approving or merging an MR needs explicit approval.",
    match = [["glab", "mr", "merge", "12"], ["glab", "mr", "approve", "12"]],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease", "--force-if-includes"]],
    decision = "prompt",
    justification = "Force push needs explicit approval.",
    match = [["git", "push", "--force", "origin", "main"], ["git", "push", "-f"]],
    not_match = [["git", "push", "origin", "feature"]],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-fR"]],
    decision = "prompt",
    justification = "rm -rf needs approval unless the target is scratch.",
    match = [["rm", "-rf", "build"]],
)

prefix_rule(
    pattern = ["jira-api", ["POST", "PUT", "DELETE"]],
    decision = "prompt",
    justification = "Jira writes need explicit approval.",
    match = [["jira-api", "POST", "/version"], ["jira-api", "DELETE", "/version/1"]],
    not_match = [["jira-api", "GET", "/myself"]],
)
