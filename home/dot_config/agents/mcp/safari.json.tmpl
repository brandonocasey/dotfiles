{
  "mcpServers": {
    "safari": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "webkit",
        "--output-dir",
        {{ joinPath .chezmoi.homeDir ".cache/agents/playwright-mcp" | toJson }},
        "--output-max-size",
        "52428800",
        "--headless"
      ],
      "env": {}
    }
  }
}
