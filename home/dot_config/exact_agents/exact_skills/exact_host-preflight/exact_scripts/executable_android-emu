#!/bin/sh
# One Android emulator per worktree, so parallel worktrees never install over each other.
#   android-emu [path]     print the adb serial of the emulator owned by the worktree at <path>
#                          (default .), starting it and waiting for boot on first use
#   android-emu rm [path]  stop that worktree's emulator and release its port
# Every worktree boots the same base AVD (default "android-base", override with ANDROID_EMU_BASE)
# read-only on its own port, so the base stays untouched and installs vanish when the emulator
# stops. Headless by default; set ANDROID_EMU_WINDOW=1 for a window. Booting can take minutes:
# run it in the background.
# The SDK, the base AVD, and the system image come from
# any-linux/run_onchange_after_09-android-sdk.sh.tmpl (chezmoi).
# A worktree owns the port in $state/claim-<port> and the process recorded in $state/<key>.port.
# It reuses or kills an emulator only when that process still runs on that port, so the user's own
# emulators (and other worktrees') are never touched.
set -eu

die() { printf 'android-emu: %s\n' "$*" >&2; exit 1; }

remove=0
if [ "${1:-}" = rm ]; then remove=1; shift; fi
top=$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null) || die "not inside a git worktree: ${1:-.}"
# Keyed by path, not branch, so a branch switch keeps the same emulator.
key=$(basename "$top")-$(printf '%s' "$top" | cksum | cut -d' ' -f1)
base=${ANDROID_EMU_BASE:-android-base}

state=${XDG_STATE_HOME:-$HOME/.local/state}/agents/android-emu
sdk=${ANDROID_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/android/sdk}
emulator=$sdk/emulator/emulator
export ANDROID_HOME="$sdk" ANDROID_SDK_ROOT="$sdk"
export ANDROID_AVD_HOME="${ANDROID_AVD_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/android/avd}"
command -v adb >/dev/null 2>&1 || die "adb not found; run chezmoi apply to install android-platform-tools"
mkdir -p "$state"
claimfile=$state/$key.port
log=$state/$key.log

# True when an emulator answers adb on this port.
alive() { adb -s "emulator-$1" get-state >/dev/null 2>&1; }

# True when <pid> still runs our emulator on <port>.
owned() {
  [ -n "${2:-}" ] && [ "$2" != 0 ] || return 1
  case " $(ps -o args= -p "$2" 2>/dev/null) " in *" -avd $base -port $1 "*) return 0 ;; *) return 1 ;; esac
}

release() {
  rm -f "$state/claim-$1/top"
  rmdir "$state/claim-$1" 2>/dev/null || true
}

# Claims the first free even port in 5554-5584 (the ones adb scans) and prints it. mkdir is the
# atomic step, so two worktrees never take the same port. A claim whose worktree is gone is reused.
claim() {
  p=5554
  while [ "$p" -le 5584 ]; do
    d=$state/claim-$p
    if [ -f "$d/top" ] && owner=$(cat "$d/top") && [ ! -d "$owner" ]; then release "$p"; fi
    if mkdir "$d" 2>/dev/null; then
      if alive "$p"; then
        rmdir "$d"
      else
        printf '%s\n' "$top" >"$d/top"
        printf '%s\n' "$p"
        return 0
      fi
    fi
    p=$((p + 2))
  done
  return 1
}

port=
pid=
if [ -f "$claimfile" ]; then read -r port pid <"$claimfile" || true; fi

if [ "$remove" = 1 ]; then
  if [ -n "$port" ]; then
    if owned "$port" "$pid"; then adb -s "emulator-$port" emu kill >/dev/null 2>&1 || true; fi
    release "$port"
  fi
  rm -f "$claimfile"
  exit 0
fi

# Check the install before claiming a port or touching the SDK, so a failure leaves nothing behind.
[ -x "$emulator" ] || die "emulator not found at $emulator; run chezmoi apply to install the Android SDK"
"$emulator" -list-avds | grep -qx "$base" ||
  die "base AVD \"$base\" not found; run chezmoi apply to create it"
# The emulator rejects an SDK root without platform-tools; link the cask's copy (it moves on upgrade).
ln -sfn "$(dirname "$(readlink -f "$(command -v adb)")")" "$sdk/platform-tools"

# A port that now answers to something we did not start (the user's emulator, a stale claim) is
# not ours: give it up and take another.
if [ -n "$port" ] && alive "$port" && ! owned "$port" "$pid"; then
  release "$port"
  port=
  pid=
fi
if [ -z "$port" ]; then
  port=$(claim) || die "no free emulator port in 5554-5584; each worktree holds one in $state (android-emu rm <worktree> frees it)"
fi
serial=emulator-$port

if ! alive "$port"; then
  case "$(uname -s)" in Linux) gpu=swiftshader_indirect ;; *) gpu=auto ;; esac
  set -- -avd "$base" -port "$port" -read-only -no-snapshot-save -no-audio -no-boot-anim -gpu "$gpu"
  [ "${ANDROID_EMU_WINDOW:-0}" = 1 ] || set -- "$@" -no-window
  nohup "$emulator" "$@" >"$log" 2>&1 &
  pid=$!
fi
printf '%s %s\n' "$port" "${pid:-0}" >"$claimfile"

# Wait for Android to finish booting, up to 300s; stop early when an emulator we started exits.
tries=0
while [ "$(adb -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" != 1 ]; do
  tries=$((tries + 1))
  [ "$tries" -le 300 ] || die "$serial did not finish booting in 300s; see $log"
  [ -z "$pid" ] || kill -0 "$pid" 2>/dev/null || die "emulator exited early: $(grep -E 'ERROR|FATAL|PANIC|ProbeKVM' "$log" | head -n 3 | tr '\n' ' ')(see $log)"
  sleep 1
done
printf '%s\n' "$serial"
