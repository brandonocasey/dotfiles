#!/bin/sh
# One iOS Simulator per worktree, so parallel worktrees never install over each other.
#   ios-sim [path]            print the UDID of the simulator owned by the worktree at <path>
#                             (default .), cloning it from the base device and booting it on first
#                             use; every call sends its sound to the silent BlackHole 2ch output
#                             (mac.Brewfile) unless `audio on` is set
#   ios-sim rm [path]         shut down and delete that worktree's simulator
#   ios-sim audio on [path]   play that worktree's simulator through the Mac's default output
#                             until `audio off` or `rm`, also when it starts later
#   ios-sim audio off [path]  silence it again
# device-audio lists what is playing and runs `audio` for every device kind.
# The base device (default name "ios-base", override with IOS_SIM_BASE) must exist and be shut down:
# it holds the shared setup (saved hosts, settings) that every clone starts from.
set -eu

SILENT_OUTPUT_UID=BlackHole2ch_UID
# CoreSimulator's value for "follow the Mac's default output", the route a booted simulator starts with.
DEFAULT_OUTPUT_UID=__sim__hostUseSystemDefaultDeviceUID
# One empty file per simulator name whose sound the user turned on.
AUDIBLE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/agents/ios-sim/audible

die() { printf 'ios-sim: %s\n' "$*" >&2; exit 1; }

# Prints the path of the sim-audio helper, building it when missing or older than its source.
build_audio_helper() {
  src=$(dirname "$0")/sim-audio.m
  bin=${XDG_CACHE_HOME:-$HOME/.cache}/agents/ios-sim/sim-audio
  if [ ! -x "$bin" ] || [ "$src" -nt "$bin" ]; then
    mkdir -p "$(dirname "$bin")"
    xcrun clang -fobjc-arc -framework Foundation -o "$bin.$$" "$src" || { rm -f "$bin.$$"; return 1; }
    mv "$bin.$$" "$bin"
  fi
  printf '%s\n' "$bin"
}

route_audio() {
  helper=$(build_audio_helper) && "$helper" "$1" "$2"
}

route_silent() {
  helper=$(build_audio_helper) || { echo "ios-sim: cannot build the sim-audio helper" >&2; return 1; }
  status=0
  "$helper" "$1" "$SILENT_OUTPUT_UID" || status=$?
  if [ "$status" = 2 ]; then
    echo "ios-sim: BlackHole 2ch must be installed (brew install --cask blackhole-2ch) and loaded (log out or restart coreaudiod)" >&2
  fi
  return "$status"
}

silence_audio() {
  route_silent "$1" || printf 'ios-sim: warning: simulator %s still plays sound aloud\n' "$1" >&2
}

mode=get
case "${1:-}" in
  rm) mode=rm; shift ;;
  audio)
    case "${2:-}" in on | off) mode=audio-$2 ;; *) die "usage: ios-sim audio on|off [path]" ;; esac
    shift 2
    ;;
esac
top=$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null) || die "not inside a git worktree: ${1:-.}"
common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)
repo=$(basename "$(dirname "$common")")
branch=$(git -C "$top" branch --show-current)
[ -n "$branch" ] || branch=$(basename "$top")
name="wt-$repo-$(printf '%s' "$branch" | tr '/ ' '--')"
base=${IOS_SIM_BASE:-ios-base}

# Prints "<udid> <state>" for the device with exactly this name.
lookup() {
  xcrun simctl list devices available -j |
    jq -r --arg n "$1" '[.devices[][] | select(.name == $n)][0] // empty | "\(.udid) \(.state)"'
}

found=$(lookup "$name")
audible=$AUDIBLE_DIR/$name
is_booted=0
[ "${found#* }" != Booted ] || is_booted=1
case $mode in
  rm)
    rm -f "$audible"
    [ -n "$found" ] || exit 0
    udid=${found%% *}
    xcrun simctl shutdown "$udid" 2>/dev/null || true
    xcrun simctl delete "$udid"
    exit 0
    ;;
  audio-on)
    mkdir -p "$AUDIBLE_DIR"
    : >"$audible"
    [ "$is_booted" = 0 ] || route_audio "${found%% *}" "$DEFAULT_OUTPUT_UID"
    exit 0
    ;;
  audio-off)
    rm -f "$audible"
    [ "$is_booted" = 0 ] || route_silent "${found%% *}" || exit 1
    exit 0
    ;;
esac

if [ -z "$found" ]; then
  src=$(lookup "$base")
  [ -n "$src" ] || die "base simulator \"$base\" not found; clone a shut-down simulator to that name first"
  [ "${src#* }" = Shutdown ] || die "base simulator \"$base\" must be shut down to clone it"
  xcrun simctl clone "${src%% *}" "$name" >/dev/null
  found=$(lookup "$name")
fi

udid=${found%% *}
[ "${found#* }" = Booted ] || xcrun simctl boot "$udid" 2>/dev/null || true
# The simulator resets its audio route on boot, so silence it on every call.
[ -e "$audible" ] || silence_audio "$udid"
printf '%s\n' "$udid"
