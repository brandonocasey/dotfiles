#!/usr/bin/env bash
# Installs the Android emulator, one system image, and the base AVD that android-emu clones per
# worktree. The android CLI and avdmanager come from the Brewfile. Reruns when this file changes (bump
# API below to move to a newer image) or when the install state below changes, so a deleted SDK or
# a cask that finally installed brings it back. Skipped in the container image (no emulator there).
{{- $data := env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local/share") }}
# adb: {{ lookPath "adb" | not | not }}, android: {{ lookPath "android" | not | not }}
# emulator: {{ stat (joinPath $data "android/sdk/emulator/emulator") | not | not }}, base AVD: {{ stat (joinPath $data "android/avd/android-base.ini") | not | not }}
set -euo pipefail

API=36

[ "${RUNNING_IN_DOCKER:-}" = true ] && exit 0

. "$CHEZMOI_SOURCE_DIR/.chezmoiscripts/.brew/brew-env.sh"

export ANDROID_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/android/sdk"
export ANDROID_USER_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/android"
export ANDROID_AVD_HOME="$ANDROID_USER_HOME/avd"
JAVA_HOME="$(brew --prefix --installed openjdk@17 2>/dev/null)" || {
  echo "openjdk@17 is not installed; skipping the Android SDK setup" >&2
  exit 0
}
export JAVA_HOME PATH="$JAVA_HOME/bin:$PATH"
command -v android >/dev/null || {
  echo "the android CLI is not installed; skipping the Android SDK setup" >&2
  exit 0
}

case "$(uname -m)" in
arm64 | aarch64) abi=arm64-v8a ;;
*) abi=x86_64 ;;
esac
image="system-images/android-$API/google_apis/$abi"

mkdir -p "$ANDROID_HOME"
# The emulator rejects an SDK root without platform-tools. Link the cask's copy, so adb stays one
# version; android-emu refreshes the link after a cask upgrade.
command -v adb >/dev/null || {
  echo "adb is not installed; skipping the Android SDK setup" >&2
  exit 0
}
ln -sfn "$(dirname "$(readlink -f "$(command -v adb)")")" "$ANDROID_HOME/platform-tools"
# Accepts the SDK licenses itself. It exits 0 even when a package is not found, so check the result.
android --no-metrics --sdk="$ANDROID_HOME" sdk install emulator "$image"
[ -x "$ANDROID_HOME/emulator/emulator" ] && [ -d "$ANDROID_HOME/$image" ] || {
  echo "android sdk install did not install emulator and $image" >&2
  exit 1
}

# avdmanager takes its SDK root from the directory it runs in (the brew cask's), not ANDROID_HOME.
export AVDMANAGER_OPTS="-Dcom.android.sdkmanager.toolsdir=$ANDROID_HOME/cmdline-tools/latest"
# Recreate the AVD when it points at another image, so bumping API moves every worktree to it.
avd_image() { grep -qx "image.sysdir.1=system-images/android-$API/google_apis/$abi/" "$ANDROID_AVD_HOME/android-base.avd/config.ini" 2>/dev/null; }
if ! avd_image; then
  # It exits non-zero over a harmless devices.xml warning, so check the result instead.
  echo no | avdmanager create avd --force --name android-base --package "${image//\//;}" --device pixel_6 || true
  avd_image
fi
