#!/usr/bin/env bash
set -euo pipefail

# TypeScript 7's tsc has a built-in language server; the
# typescript-language-server wrapper in ~/.local/bin runs it for Claude Code.
# TypeScript 7 dropped baseUrl and node10 resolution, so the wrapper falls back
# to the legacy server with TypeScript 6 for projects that still use them.
TS_VERSION='7.0.2'
LEGACY_TSLS_VERSION='6.0.2'
LEGACY_TS_VERSION='6.0.3'
LEGACY_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/typescript-ls-legacy"

if command -v mise >/dev/null 2>&1; then
  mise install
  eval "$(mise activate bash)"
fi

# Match the npmrc prefix even when chezmoi runs without the shell env, so a
# node upgrade cannot drop the install.
export NPM_CONFIG_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/npm"
export PATH="${NPM_CONFIG_PREFIX}/bin:${PATH}"

if ! command -v npm >/dev/null 2>&1; then
  echo "npm is required to install TypeScript" >&2
  exit 1
fi

# The npm typescript-language-server would shadow the wrapper.
if npm ls --global --depth=0 typescript-language-server >/dev/null 2>&1; then
  npm uninstall --global typescript-language-server
fi

echo "Installing TypeScript ${TS_VERSION}"
npm install --global "typescript@${TS_VERSION}"

echo "Installing legacy typescript-language-server ${LEGACY_TSLS_VERSION} with TypeScript ${LEGACY_TS_VERSION}"
mkdir -p "$LEGACY_DIR"
npm install --prefix "$LEGACY_DIR" --no-save --no-package-lock \
  "typescript-language-server@${LEGACY_TSLS_VERSION}" "typescript@${LEGACY_TS_VERSION}"
