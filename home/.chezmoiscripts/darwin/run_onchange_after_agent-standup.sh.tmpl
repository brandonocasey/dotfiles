#!/usr/bin/env bash

# Reload the end-of-day standup when its launch agent changes.
# plist hash: {{ include "private_Library/private_LaunchAgents/com.bcasey.agent-standup.plist.tmpl" | sha256sum }}

plist="$HOME/Library/LaunchAgents/com.bcasey.agent-standup.plist"
mkdir -p "$HOME/.local/state/agents/standup"
launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null
sleep 1
launchctl bootstrap "gui/$(id -u)" "$plist"
