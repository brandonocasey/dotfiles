<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bcasey.agent-standup</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.local/bin/agent-standup</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLAUDE_CONFIG_DIR</key>
        <string>{{ .chezmoi.homeDir }}/.claude-two</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
{{- range $day := list 1 2 3 4 5 }}
        <dict>
            <key>Weekday</key>
            <integer>{{ $day }}</integer>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
{{- end }}
    </array>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/agents/standup/launchd.log</string>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.local/state/agents/standup/launchd.log</string>
</dict>
</plist>
