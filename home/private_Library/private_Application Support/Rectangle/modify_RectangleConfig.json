JSON
)

live=$(cat)

# jq ships in the shared brew bundle installed before chezmoi applies files, so
# this is the bootstrap edge case only. Never destroy the live file.
if ! command -v jq >/dev/null 2>&1; then
  if [ -n "${live//[[:space:]]/}" ]; then
    printf '%s\n' "$live"
  else
    printf '%s\n' "$managed"
  fi
  exit 0
fi

# A corrupt or non-object live file MUST fall back to the managed defaults.
live=$(printf '%s' "$live" | jq -s -c 'first // {} | if type == "object" then . else {} end' 2>/dev/null) || live='{}'
[ -n "$live" ] || live='{}'

jq -n \
  --argjson keep "$KEEP_KEYS" \
  --argjson managed "$managed" \
  --argjson live "$live" \
  'reduce $keep[] as $k ($managed;
     if ($live.defaults // {} | has($k)) then .defaults[$k] = $live.defaults[$k] else . end)'
