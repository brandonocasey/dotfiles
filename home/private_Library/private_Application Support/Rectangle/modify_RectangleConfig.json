#!/bin/bash
# chezmoi modify_ script, same pattern as ~/.claude/settings.json. It reads the
# live RectangleConfig.json on stdin and prints the file chezmoi should apply.
# Every key in the managed JSON below is enforced EXCEPT the ones in KEEP_KEYS
# (inside .defaults), whose live values are carried through — they are
# Rectangle bookkeeping state, not settings, so they never show as drift.
# Managed floats are pre-rounded, which also kills Float32 export noise
# (0.30000001192092896 vs 0.3). To change a real setting, edit the JSON below.
set -euo pipefail

KEEP_KEYS='["SUEnableAutomaticChecks", "SUHasLaunchedBefore", "lastVersion"]'

managed=$(
  cat <<'JSON'
