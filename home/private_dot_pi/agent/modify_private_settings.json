#!/usr/bin/env bash
# chezmoi modify_ script for Pi's global settings. Keep Pi-owned settings such
# as the selected model and theme, but enforce the extensions used by this setup.
set -euo pipefail

managed='{
  "packages": [
    "npm:pi-mcp-adapter@2.32.1",
    "npm:pi-subagents@0.88.1"
  ],
  "extensions": ["-builtin:mcp"],
  "enableSkillCommands": true,
  "compaction": {
    "modelOverrides": {
      "anthropic/claude-fable-5": { "reserveTokens": 600000 },
      "anthropic/claude-fable-5-1": { "reserveTokens": 600000 },
      "anthropic/claude-fable-5-2": { "reserveTokens": 600000 },
      "anthropic/claude-haiku-5-5": { "reserveTokens": 600000 },
      "anthropic/claude-opus-4-6": { "reserveTokens": 600000 },
      "anthropic/claude-opus-4-7": { "reserveTokens": 600000 },
      "anthropic/claude-opus-4-8": { "reserveTokens": 600000 },
      "anthropic/claude-opus-5": { "reserveTokens": 600000 },
      "anthropic/claude-opus-5-5": { "reserveTokens": 600000 },
      "anthropic/claude-sonnet-4-6": { "reserveTokens": 600000 },
      "anthropic/claude-sonnet-5": { "reserveTokens": 600000 },
      "anthropic/claude-sonnet-5-5": { "reserveTokens": 600000 }
    }
  }
}'

# Shared skills live in ~/.agents/skills, which Pi scans recursively, so the
# app-owned synced/<account>/ copies collide with each other. Mirror Codex:
# hide the app-owned skills and any repeats. Pi finds them through the
# ~/.agents/skills symlink, so exclude both path forms.
skills='[]'
if command -v jq >/dev/null 2>&1; then
  skill_lines=""
  seen=" "
  for skill_file in "$HOME"/.config/agents/skills/synced/*/*/SKILL.md; do
    [ -f "$skill_file" ] || continue
    dir=${skill_file%/SKILL.md}
    name=${dir##*/}
    case " docs docx pdf xlsx pptx google-workspace skill-creator chrome-browser computer-use built-in-browser " in
      *" $name "*) skill_lines+="-$dir"$'\n'"-${dir/\/.config\/agents\//\/.agents\/}"$'\n'; continue ;;
    esac
    case "$seen" in *" $name "*) skill_lines+="-$dir"$'\n'"-${dir/\/.config\/agents\//\/.agents\/}"$'\n' ;; *) seen+="$name " ;; esac
  done
  skills=$(printf '%s' "$skill_lines" | jq -R -s -c 'split("\n") | map(select(length > 0))')
fi

live=$(cat)

if ! command -v jq >/dev/null 2>&1; then
  if [ -n "${live//[[:space:]]/}" ]; then
    printf '%s\n' "$live"
  else
    printf '%s\n' "$managed"
  fi
  exit 0
fi

live=$(printf '%s' "$live" | jq -s -c \
  'first // {} | if type == "object" then . else {} end' 2>/dev/null) || live='{}'
[ -n "$live" ] || live='{}'

jq -n --argjson live "$live" --argjson managed "$managed" --argjson skills "$skills" \
  '$live * $managed * {skills: $skills}'
